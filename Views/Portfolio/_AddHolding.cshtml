@using AutoSignals.Models
@model PortfolioHolding

@{
    var displaySymbol = ViewBag.DisplaySymbol as Func<string?, string> ?? (s => s ?? "");
}

<div class="modal fade" id="addHoldingModal" tabindex="-1" aria-labelledby="addHoldingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addHoldingModalLabel">Add Holding</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddHolding" method="post" id="addHoldingForm">
                <input type="hidden" name="portfolioId" value="@ViewBag.PortfolioId" />

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="AssetSymbol" class="form-label">Asset Symbol *</label>
                        <select asp-for="AssetSymbol" class="form-select" id="assetSelect" required>
                            <option value="">Select Asset</option>
                            @if (ViewBag.SpotSymbols != null)
                            {
                                @foreach (var symbol in ViewBag.SpotSymbols)
                                {
                                    <option value="@symbol">@displaySymbol(symbol)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="AssetSymbol" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="form-label">Quantity *</label>
                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   pattern="^\d+([.,]\d{1,8})?$"
                                   placeholder="0.00000000"
                                   required />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                            <div class="form-text">Up to 8 decimal places (e.g., 0.12345678)</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="AverageBuyPrice" class="form-label">Average Buy Price (USD) *</label>
                            <input asp-for="AverageBuyPrice"
                                   class="form-control"
                                   type="number"
                                   step="0.0001"
                                   min="0"
                                   placeholder="0.00"
                                   required />
                            <span asp-validation-for="AverageBuyPrice" class="text-danger"></span>
                            <div class="form-text">Up to 2 decimal places (e.g., 45000.50)</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes about this holding"></textarea>
                    </div>

                    <div id="pricePreview" class="alert alert-info d-none">
                        <small><i class="fas fa-info-circle me-1"></i> Current price: <span id="currentPriceDisplay" class="fw-bold">$0.00</span></small>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Holding</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(function () {
        $.validator.unobtrusive.parse("#addHoldingForm");

        // Fix decimal separator BEFORE validation
        $('#addHoldingForm').on('submit', function (e) {
            const $qty = $('#Quantity');
            const $avg = $('#AverageBuyPrice');

            // Convert comma to period for decimal parsing
            if ($qty.length && $qty.val()) {
                // Remove any non-numeric characters except decimal point and comma
                let qtyVal = $qty.val().toString().trim();
                // Replace comma with period
                qtyVal = qtyVal.replace(',', '.');
                // Remove any characters that aren't digits or a single decimal point
                qtyVal = qtyVal.replace(/[^\d.]/g, '');
                // Ensure only one decimal point
                const parts = qtyVal.split('.');
                if (parts.length > 2) {
                    qtyVal = parts[0] + '.' + parts.slice(1).join('');
                }
                $qty.val(qtyVal);
            }

            if ($avg.length && $avg.val()) {
                let avgVal = $avg.val().toString().trim();
                avgVal = avgVal.replace(',', '.');
                avgVal = avgVal.replace(/[^\d.]/g, '');
                const parts = avgVal.split('.');
                if (parts.length > 2) {
                    avgVal = parts[0] + '.' + parts.slice(1).join('');
                }
                $avg.val(avgVal);
            }
        });

        $('#assetSelect').change(function () {
            const symbol = $(this).val();
            if (symbol) getCurrentPrice(symbol);
            else $('#pricePreview').addClass('d-none');
        });

        // Pre-select first option if none selected
        if ($('#assetSelect option').length > 1 && !$('#assetSelect').val()) {
            $('#assetSelect').val($('#assetSelect option:eq(1)').val()).trigger('change');
        }
    });

    function getCurrentPrice(symbol) {
        $.ajax({
            url: '@Url.Action("GetCurrentPrice", "Portfolio")',
            type: 'GET',
            data: { symbol: symbol },
            success: function(data) {
                if (data && data.price > 0) {
                    $('#pricePreview').removeClass('d-none');
                    $('#currentPriceDisplay').text('$' + parseFloat(data.price).toFixed(2));
                }
            }
        });
    }
</script>