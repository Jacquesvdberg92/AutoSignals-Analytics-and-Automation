@using AutoSignals.Models
@model List<Portfolio>

@{
    ViewData["Title"] = "Portfolio Dashboard";
    var activePortfolio = ViewBag.ActivePortfolio as Portfolio;

    var totalValue = activePortfolio?.TotalValue ?? 0m;
    var totalCost = (decimal?)ViewBag.TotalCost ?? 0m;
    var totalPnL = (decimal?)ViewBag.TotalPnL ?? 0m;
    var totalPnLPct = (decimal?)ViewBag.TotalPnLPercentage ?? 0m;

    var holdingSummaries = ViewBag.HoldingSummaries as List<PortfolioHoldingSummary> ?? new();
    var displaySymbol = ViewBag.DisplaySymbol as Func<string?, string> ?? (s => s ?? "");
}

<!-- Start::page-header -->
<div class="d-flex align-items-center justify-content-between page-header-breadcrumb flex-wrap gap-2">
    <div>
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item">
                <a href="javascript:void(0);">Dashboards</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Portfolio</li>
        </ol>
        <h1 class="page-title fw-medium fs-18 mb-0">
            Portfolio Dashboard
            @if (activePortfolio != null)
            {
                <span class="text-muted">— @activePortfolio.Name</span>
            }
        </h1>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group">
            @if (Model.Count < 5)
            {
                <button type="button" class="btn btn-success" onclick="loadCreateModal()">
                    <i class="ti ti-plus"></i> New Portfolio
                </button>
            }

            @if (activePortfolio != null)
            {
                <button type="button" class="btn btn-primary" onclick="loadAddHoldingModal(@activePortfolio.Id)">
                    <i class="ti ti-plus"></i> Add Holding
                </button>
            }
        </div>
    </div>
</div>
<!-- End::page-header -->

<!-- Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Portfolio Tabs -->
<div class="row">
    <div class="col-12">
        <div class="card custom-card">
        <div class="card-header">
        Your Portfolios
        </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var portfolio in Model)
                    {
                        <a asp-action="Dashboard"
                           asp-route-portfolioId="@portfolio.Id"
                           class="btn @(portfolio.Id == activePortfolio?.Id ? "btn-primary" : "btn-outline-primary")">
                            @portfolio.Name
                            @if (portfolio.IsDefault)
                            {
                                <span class="badge bg-warning ms-1">Default</span>
                            }
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (activePortfolio != null)
{
    <!-- Quick Stats Cards (VIP style) -->
    <div class="row">
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card custom-card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="avatar avatar-md bg-primary-transparent">
                                <i class="ti ti-wallet fs-20"></i>
                            </span>
                        </div>
                        <div class="text-end">
                            <h5 class="mb-0">@totalValue.ToString("C")</h5>
                            <span class="text-muted fs-12">Total Value</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-muted fs-12">Portfolio:</span>
                        <span class="fw-medium fs-14">@activePortfolio.Name</span>
                        @if (activePortfolio.IsDefault)
                        {
                            <span class="float-end badge bg-warning-transparent">Default</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card custom-card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="avatar avatar-md bg-info-transparent">
                                <i class="ti ti-currency-dollar fs-20"></i>
                            </span>
                        </div>
                        <div class="text-end">
                            <h5 class="mb-0">@totalCost.ToString("C")</h5>
                            <span class="text-muted fs-12">Total Cost</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-muted fs-12">Holdings:</span>
                        <span class="fw-medium fs-14">@holdingSummaries.Count</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card custom-card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="avatar avatar-md bg-success-transparent">
                                <i class="ti ti-trending-up fs-20"></i>
                            </span>
                        </div>
                        <div class="text-end">
                            <h5 class="mb-0 text-@(totalPnL >= 0 ? "success" : "danger")">@totalPnL.ToString("C")</h5>
                            <span class="text-muted fs-12">Total P&amp;L</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <span class="text-muted fs-12">P&amp;L %:</span>
                        <span class="fw-medium fs-14 text-@(totalPnLPct >= 0 ? "success" : "danger")">
                            @totalPnLPct.ToString("F2")%
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card custom-card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <span class="avatar avatar-md bg-warning-transparent">
                                <i class="ti ti-star fs-20"></i>
                            </span>
                        </div>
                        <div class="text-end">
                            <h5 class="mb-0">@((activePortfolio.IsDefault) ? "Yes" : "No")</h5>
                            <span class="text-muted fs-12">Default Portfolio</span>
                        </div>
                    </div>
                    <div class="mt-3 d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div>
                            @if (!activePortfolio.IsDefault)
                            {
                                <form asp-action="SetDefault" method="post" class="m-0 d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@activePortfolio.Id" />
                                    <button type="submit" class="btn btn-sm btn-warning">
                                        <i class="ti ti-star"></i> Set as Default
                                    </button>
                                </form>
                            }      
                        </div>

                        <div class="btn-group">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="loadRenamePortfolioModal(@activePortfolio.Id)">
                                <i class="ti ti-pencil"></i> Rename
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="loadDeletePortfolioModal(@activePortfolio.Id)">
                                <i class="ti ti-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Holdings -->
    <div class="row">
        <div class="col-12">
            <div class="card custom-card">
                <div class="card-header">
                    <h6 class="card-title mb-0">Holdings</h6>
                </div>
                <div class="card-body">
                    @if (holdingSummaries.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>Asset</th>
                                        <th>Quantity</th>
                                        <th>Avg Price (weighted)</th>
                                        <th>Current Price</th>
                                        <th>Current Value</th>
                                        <th>Cost Basis</th>
                                        <th>P&amp;L</th>
                                        <th>% of Portfolio</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var holding in holdingSummaries.OrderByDescending(h => h.CurrentValue))
                                    {
                                        <tr style="cursor:pointer"
                                            onclick="loadManageAssetModal(@activePortfolio.Id, '@holding.AssetSymbol')">
                                            <td><span class="fw-medium">@displaySymbol(holding.AssetSymbol)</span></td>
                                            <td>@holding.Quantity.ToString("F8")</td>
                                            <td>@holding.AverageBuyPrice.ToString("C")</td>
                                            <td>@holding.CurrentPrice.ToString("C")</td>
                                            <td>@holding.CurrentValue.ToString("C")</td>
                                            <td>@holding.CostBasis.ToString("C")</td>
                                            <td class="fw-medium text-@(holding.PnL >= 0 ? "success" : "danger")">
                                                @holding.PnL.ToString("C") (@holding.PnLPercentage.ToString("F2")%)
                                            </td>
                                            <td>@holding.PortfolioPercentage.ToString("F1")%</td>
                                            <td class="text-muted">
                                                <small>Per-lot actions</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="ti ti-coins fs-1 text-muted mb-3 d-block"></i>
                            <h4 class="mb-2">No holdings yet</h4>
                            <p class="text-muted mb-3">Start by adding your first crypto holding</p>
                            <button class="btn btn-primary" onclick="loadAddHoldingModal(@activePortfolio.Id)">
                                <i class="ti ti-plus"></i> Add First Holding
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Count == 0)
{
    <div class="row">
        <div class="col-12">
            <div class="card custom-card">
                <div class="card-body text-center py-5">
                    <i class="ti ti-chart-pie fs-1 text-muted mb-3 d-block"></i>
                    <h3 class="mb-2">No portfolios yet</h3>
                    <p class="text-muted mb-3">Create your first portfolio to start tracking your crypto</p>
                    <button class="btn btn-primary" onclick="loadCreateModal()">
                        <i class="ti ti-plus"></i> Create First Portfolio
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modals Container -->
<div id="modals-container"></div>

@section scripts {
    <script>
        window.portfolioDashboardUrls = {
            create: '@Url.Action("Create", "Portfolio")',
            addHolding: '@Url.Action("AddHolding", "Portfolio")',
            editHolding: '@Url.Action("EditHolding", "Portfolio")',
            manageAsset: '@Url.Action("ManageAsset", "Portfolio")',
            rename: '@Url.Action("Rename", "Portfolio")',
            delete: '@Url.Action("Delete", "Portfolio")',
            getCurrentPrice: '@Url.Action("GetCurrentPrice", "Portfolio")'
        };
    </script>

    <script src="~/js/portfolio/dashboard.js" asp-append-version="true"></script>
}