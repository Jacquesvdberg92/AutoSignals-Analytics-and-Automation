@using AutoSignals.Models
@model PortfolioHolding

@{
    var displaySymbol = ViewBag.DisplaySymbol as Func<string?, string> ?? (s => s ?? "");
}

<div class="modal fade" id="editHoldingModal" tabindex="-1" aria-labelledby="editHoldingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editHoldingModalLabel">Edit @displaySymbol(Model.AssetSymbol) Holding</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditHolding" method="post" id="editHoldingForm">
                <input type="hidden" asp-for="Id" />

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="AssetSymbol" class="form-label">Asset Symbol *</label>
                        <input asp-for="AssetSymbol" class="form-control" id="assetSymbolInput" required />
                        <span asp-validation-for="AssetSymbol" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="form-label">Quantity *</label>
                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   pattern="^\d+([.,]\d{1,8})?$"
                                   placeholder="0.00000000"
                                   required />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                            <div class="form-text">Up to 8 decimal places (e.g., 0.12345678)</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="AverageBuyPrice" class="form-label">Average Buy Price (USD) *</label>
                            <input asp-for="AverageBuyPrice"
                                   class="form-control"
                                   type="number"
                                   step="0.0001"
                                   min="0"
                                   placeholder="0.00"
                                   required />
                            <span asp-validation-for="AverageBuyPrice" class="text-danger"></span>
                            <div class="form-text">Up to 2 decimal places (e.g., 45000.50)</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="alert alert-light">
                        <div class="row">
                            <div class="col-md-6">
                                <small class="text-muted">Current Price</small>
                                <div class="fw-bold">$@Model.CurrentPrice.ToString("F2")</div>
                            </div>
                            <div class="col-md-6">
                                <small class="text-muted">Last Updated</small>
                                <div>@Model.LastUpdated.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(function() {
        // Initialize validation
        $.validator.unobtrusive.parse("#editHoldingForm");

        // Fix decimal separator BEFORE validation (match Add Holding)
        $('#editHoldingForm').on('submit', function (e) {
            const $qty = $('#Quantity');
            const $avg = $('#AverageBuyPrice');

            if ($qty.length && $qty.val()) {
                let qtyVal = $qty.val().toString().trim();
                qtyVal = qtyVal.replace(',', '.');
                qtyVal = qtyVal.replace(/[^\d.]/g, '');
                const parts = qtyVal.split('.');
                if (parts.length > 2) qtyVal = parts[0] + '.' + parts.slice(1).join('');
                $qty.val(qtyVal);
            }

            if ($avg.length && $avg.val()) {
                let avgVal = $avg.val().toString().trim();
                avgVal = avgVal.replace(',', '.');
                avgVal = avgVal.replace(/[^\d.]/g, '');
                const parts = avgVal.split('.');
                if (parts.length > 2) avgVal = parts[0] + '.' + parts.slice(1).join('');
                $avg.val(avgVal);
            }
        });

        // Fix step attribute issue
        $('#Quantity').on('input', function() {
            const value = $(this).val();
            if (value.includes('.')) {
                const parts = value.split('.');
                if (parts[1].length > 8) {
                    $(this).val(parts[0] + '.' + parts[1].substring(0, 8));
                }
            }
        });
    });
</script>