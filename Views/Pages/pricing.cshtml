@section scripts {
    <!-- Pricing JS -->
    <script src="@Url.Content("~/assets/js/pricing.js")"></script>
    <script>
        // Prevent event bubbling when clicking on buttons inside cards
        $(document).ready(function() {
            $('.card .btn').on('click', function(e) {
                e.stopPropagation();
                window.location.href = '/Identity/Account/Register';
            });
        });
    </script>
}