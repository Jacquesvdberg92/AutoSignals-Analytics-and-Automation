@model List<AutoSignals.Models.SubscriptionPlan>
@using AutoSignals.Models
@{
    var proMonthly  = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.Pro && !p.IsAnnual);
    var proAnnual   = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.Pro && p.IsAnnual);
    var vipMonthly  = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.VIP && !p.IsAnnual);
    var vipAnnual   = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.VIP && p.IsAnnual);
}
@section styles {
    <style>
        /* ── Trial Banner ── */
        .trial-hero {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            border-radius: 16px;
            padding: 28px 36px;
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }
        .trial-hero::before {
            content: '';
            position: absolute;
            top: -40px; right: -40px;
            width: 200px; height: 200px;
            background: rgba(255,255,255,0.06);
            border-radius: 50%;
        }
        .trial-hero::after {
            content: '';
            position: absolute;
            bottom: -60px; left: -30px;
            width: 240px; height: 240px;
            background: rgba(255,255,255,0.04);
            border-radius: 50%;
        }

        /* ── Pricing Cards ── */
        .pricing-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 2px solid transparent !important;
            cursor: default;
        }
        .pricing-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 24px 40px -8px rgba(0,0,0,0.15) !important;
        }
        .pricing-card.card-popular {
            border-color: #6366f1 !important;
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -8px rgba(99,102,241,0.25) !important;
        }
        .pricing-card.card-popular:hover {
            transform: translateY(-10px);
        }
        .pricing-card.card-vip {
            border-color: #f59e0b !important;
        }
        .pricing-card.card-vip:hover {
            box-shadow: 0 24px 40px -8px rgba(245,158,11,0.2) !important;
        }

        /* ── Popular badge ribbon ── */
        .popular-ribbon {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 4px 14px;
            border-radius: 20px;
        }
        .vip-ribbon {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #000;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 4px 14px;
            border-radius: 20px;
        }

        /* ── Price display ── */
        .price-amount {
            font-size: 2.6rem;
            font-weight: 800;
            line-height: 1;
        }
        .price-amount.text-pro  { color: #6366f1; }
        .price-amount.text-vip  { color: #f59e0b; }
        .price-amount.text-free { color: #10b981; }

        /* ── Feature rows ── */
        .pricing-body li {
            padding: 6px 0;
            border-bottom: 1px solid rgba(0,0,0,0.04);
        }
        .pricing-body li:last-child { border-bottom: none; }
        .feature-muted .ms-2 {
            color: #adb5bd;
            text-decoration: line-through;
        }

        /* ── How-it-works timeline ── */
        .trial-step {
            position: relative;
            padding-left: 52px;
        }
        .trial-step-icon {
            position: absolute;
            left: 0;
            top: 0;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .trial-step-line {
            position: absolute;
            left: 19px;
            top: 38px;
            width: 2px;
            height: calc(100% + 16px);
            background: #e2e8f0;
        }
        .trial-step:last-child .trial-step-line { display: none; }

        @@keyframes pulse-cta {
            0%   { box-shadow: 0 0 0 0 rgba(99,102,241,0.4); }
            70%  { box-shadow: 0 0 0 10px rgba(99,102,241,0); }
            100% { box-shadow: 0 0 0 0 rgba(99,102,241,0); }
        }
        .btn-pulse { animation: pulse-cta 2s infinite; }
    </style>
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between page-header-breadcrumb flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Pages</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pricing</li>
            </ol>
        </nav>
        <h1 class="page-title fw-medium fs-18 mb-0">Pricing</h1>
    </div>
</div>
<!-- Page Header Close -->

