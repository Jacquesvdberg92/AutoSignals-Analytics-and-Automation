@section styles {
    <style>
        .free-badge {
            background: linear-gradient(145deg, #28a745, #20c997);
            color: white;
            padding: 8px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: 1px;
            box-shadow: 0 10px 20px -5px rgba(40, 167, 69, 0.4);
            display: inline-block;
            margin-bottom: 15px;
            text-transform: uppercase;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .price-tag {
            position: relative;
            display: inline-block;
        }

        .original-price {
            text-decoration: line-through;
            color: #dc3545;
            font-size: 1.2rem;
            font-weight: 400;
            opacity: 0.7;
            margin-right: 8px;
        }

        .free-price {
            color: #28a745;
            font-size: 2rem;
            font-weight: 800;
            text-shadow: 0 2px 10px rgba(40, 167, 69, 0.3);
        }

        .limited-offer {
            background: linear-gradient(145deg, #ffc107, #fd7e14);
            color: #000;
            font-weight: 700;
            padding: 12px 25px;
            border-radius: 8px;
            margin: 20px 0 10px;
            border: none;
            box-shadow: 0 8px 16px -4px rgba(255, 193, 7, 0.4);
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.02);
                box-shadow: 0 12px 24px -4px rgba(255, 193, 7, 0.6);
            }

            100% {
                transform: scale(1);
            }
        }

        .savings-badge {
            background: #ffc107;
            color: #000;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            margin-left: 10px;
            text-transform: uppercase;
        }

        .text-gradient {
            background: linear-gradient(145deg, #28a745, #20c997);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 2px solid transparent;
            cursor: pointer;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 30px -8px rgba(0, 0, 0, 0.15);
                border-color: #28a745;
            }

            .card .btn {
                pointer-events: none;
            }

        .registration-hint {
            font-size: 0.75rem;
            color: #6c757d;
            opacity: 0.8;
            margin-top: 5px;
        }
    </style>
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between page-header-breadcrumb flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Pages</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pricing</li>
            </ol>
        </nav>
        <h1 class="page-title fw-medium fs-18 mb-0">Pricing</h1>
    </div>
</div>
<!-- Page Header Close -->
