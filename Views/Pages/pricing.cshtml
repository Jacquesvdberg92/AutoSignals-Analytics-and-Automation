<!-- Trial Policy Hero Banner -->
<div class="trial-hero d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div class="d-flex align-items-center gap-4 position-relative" style="z-index:1;">
        <div class="fs-1 lh-1">🚀</div>
        <div>
            <h4 class="mb-1 fw-bold text-white">Start with 30 days of Pro — completely free</h4>
            <p class="mb-0 text-white fs-14" style="opacity:0.85;">
                Every new account gets full <strong>Pro access for 30 days</strong>. No credit card. No catch.
                After your trial, choose a plan or drop to our free tier.
            </p>
        </div>
    </div>
    <a href="/Identity/Account/Register"
       class="btn btn-light btn-lg fw-bold text-nowrap btn-wave position-relative btn-pulse"
       style="z-index:1;">
        <i class="ti ti-gift me-2"></i>Claim Your Free Trial
    </a>
</div>

<!-- Monthly / Annual Toggle -->
<div class="d-flex justify-content-center align-items-center gap-3 mb-4">
    <span class="fs-14 fw-medium text-muted">Monthly</span>
    <div class="switcher-pricing">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="pricingToggle" role="switch" style="width:3rem;height:1.5rem;cursor:pointer;">
        </div>
    </div>
    <span class="fs-14 fw-medium text-muted">Annual&nbsp;<span class="badge bg-success fs-11">Save 20%</span></span>
