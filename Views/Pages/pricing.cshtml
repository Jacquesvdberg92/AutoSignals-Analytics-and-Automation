<!-- How the trial works — Trial Policy (Section 2)          -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="row justify-content-center mb-2">
    <div class="col-xl-8 col-lg-10">
        <div class="card custom-card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="ti ti-info-square-rounded me-2 text-primary"></i>How the 30-day trial works
                </h5>
            </div>
            <div class="card-body pt-3 pb-4">

                <!-- Step 1 -->
                <div class="trial-step mb-4">
                    <div class="trial-step-icon bg-primary bg-opacity-10 text-primary">
                        <i class="ti ti-user-plus fs-18"></i>
                    </div>
                    <div class="trial-step-line"></div>
                    <div class="ps-1">
                        <h6 class="fw-bold mb-1">Register — takes 60 seconds</h6>
                        <p class="text-muted fs-13 mb-0">
                            Create a free account. No credit card, no commitment.
                            Your 30-day Pro trial starts the moment you verify your email.
                        </p>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="trial-step mb-4">
                    <div class="trial-step-icon bg-success bg-opacity-10 text-success">
                        <i class="ti ti-bolt fs-18"></i>
                    </div>
                    <div class="trial-step-line"></div>
                    <div class="ps-1">
                        <h6 class="fw-bold mb-1">Enjoy full Pro access for 30 days</h6>
                        <p class="text-muted fs-13 mb-0">
                            Real-time signals, auto-trading, analytics, AI predictions, Telegram notifications —
                            everything in the Pro tier, unlocked immediately and completely free.
                        </p>
                    </div>
                </div>

                <!-- Step 3 — warning email -->
                <div class="trial-step mb-4">
                    <div class="trial-step-icon bg-warning bg-opacity-10 text-warning">
                        <i class="ti ti-bell-ringing fs-18"></i>
                    </div>
                    <div class="trial-step-line"></div>
                    <div class="ps-1">
                        <h6 class="fw-bold mb-1">Reminder at day 25</h6>
                        <p class="text-muted fs-13 mb-0">
                            We'll email you 5 days before your trial ends so you're never caught off guard.
                            No surprise charges — ever.
                        </p>
                    </div>
                </div>

                <!-- Step 4 — choose -->
                <div class="trial-step">
                    <div class="trial-step-icon bg-info bg-opacity-10 text-info">
                        <i class="ti ti-arrows-split-2 fs-18"></i>
                    </div>
                    <div class="ps-1">
                        <h6 class="fw-bold mb-1">At day 30 — you choose</h6>
                        <p class="text-muted fs-13 mb-2">
                            Subscribe to keep your Pro (or upgrade to VIP), or automatically drop to the
                            <strong>free Freemium tier</strong>. Your account and data are never deleted.
                        </p>
