@model AutoSignals.Models.SignalProvider


@{
    ViewData["Title"] = ViewContext.RouteData.Values["action"] + " Provider";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="@ViewContext.RouteData.Values["action"]">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        @if (ViewContext.RouteData.Values["action"].ToString() == "Edit")
                        {
                            <input type="hidden" asp-for="Id" />
                        }

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Provider Name *</label>
                                <input asp-for="Name" class="form-control" required />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TelegramGroupId" class="form-label">Telegram Group ID *</label>
                                <input asp-for="TelegramGroupId" class="form-control" placeholder="-1001234567890" required />
                                <span asp-validation-for="TelegramGroupId" class="text-danger"></span>
                                <small class="text-muted">The numeric ID of the Telegram group/channel</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TelegramGroupName" class="form-label">Telegram Group Name</label>
                            <input asp-for="TelegramGroupName" class="form-control" />
                            <span asp-validation-for="TelegramGroupName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-3 text-muted">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Active</label>
                        </div>

                        <div class="form-check form-switch mb-3 text-muted">
                            <input class="form-check-input" type="checkbox" asp-for="UseAiFallback" />
                            <label class="form-check-label" asp-for="UseAiFallback">Use AI Fallback Parser</label>
                            <div><small class="text-muted">When regex rules can't fully parse a message, the AI will attempt to extract a valid signal.</small></div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fe fe-arrow-left"></i> Back to List
                            </a>
                            <div class="btn-group">
                                @if (Model.ParsingRules.Any())
                                {
                                    <!-- Test Parsing Modal Button -->
                                    <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#testParsingModal">
                                        <i class="fe fe-play"></i> Test Parsing Rules
                                    </button>
                                }
                                <button type="submit" class="btn btn-primary">
                                    <i class="fe fe-check"></i> Save Provider
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @if (ViewContext.RouteData.Values["action"].ToString() == "Edit")
        {
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h4>Parsing Rules</h4>
                    </div>
                    <div class="card-body">
                        @if (Model.ParsingRules.Any())
                        {
                            <div class="list-group">
                                @foreach (var rule in Model.ParsingRules.OrderBy(r => r.Order))
                                {
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1 me-3">
                                                <div class="d-flex align-items-center mb-1">
                                                    <span class="badge bg-primary me-2">#@rule.Order</span>
                                                    <strong>@rule.RuleType</strong>
                                                    @if (rule.IsRequired)
                                                    {
                                                        <span class="badge bg-danger ms-2">Required</span>
                                                    }
                                                </div>
                                                <div class="small text-muted mb-2">
                                                    <code>@rule.RegexPattern</code>
                                                </div>
                                                @if (!string.IsNullOrEmpty(rule.RegexGroupName))
                                                {
                                                    <small class="text-info me-3">
                                                        <i class="fe fe-hash"></i> Group: @rule.RegexGroupName
                                                    </small>
                                                }
                                                @if (!string.IsNullOrEmpty(rule.FallbackValue))
                                                {
                                                    <small class="text-warning">
                                                        <i class="fe fe-alert-circle"></i> Fallback: @rule.FallbackValue
                                                    </small>
                                                }
                                            </div>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-action="EditRule" asp-route-id="@rule.Id"
                                                   class="btn btn-outline-primary" title="Edit Rule">
                                                    <i class="fe fe-edit"></i>
                                                </a>
                                                <button type="button" class="btn btn-outline-danger btn-sm delete-rule-ajax"
                                                        data-rule-id="@rule.Id" title="Delete Rule">
                                                    <i class="fe fe-trash-2"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No parsing rules defined.</p>
                        }
                        
                        <div class="mt-3">
                            <a asp-action="CreateRule" asp-route-providerId="@Model.Id" class="btn btn-success btn-sm">
                                <i class="fe fe-plus"></i> Add New Rule
                            </a>
                            <a asp-action="GenerateRules" asp-route-providerId="@Model.Id" class="btn btn-outline-primary btn-sm ms-2">
                                <i class="fe fe-zap"></i> Generate Rules with AI
                            </a>
                            @* @if (Model.ParsingRules.Any())
                            {
                                <!-- Keep the direct link as backup -->
                                <a asp-action="TestParsing" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm ms-2">
                                    <i class="fe fe-external-link"></i> Open Full Test
                                </a>
                            } *@
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (ViewContext.RouteData.Values["action"].ToString() == "Edit")
{
    var testModel = new AutoSignals.ViewModels.ProviderRegex.TestRegexViewModel
    {
        ProviderId = Model.Id,
        ProviderName = Model.Name,
        TelegramMessage = ""
    };
    
    @await Html.PartialAsync("_TestParsingModal", testModel)
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        document.body.dataset.deleteRuleAjaxUrl = '@Url.Action("DeleteRuleAjax", "SignalProvidersParsing")';
    </script>

    <script src="~/assets/SignalProvidersParsing-js/edit-provider.js" asp-append-version="true"></script>
}