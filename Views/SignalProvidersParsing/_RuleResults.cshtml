@using AutoSignals.ViewModels.ProviderRegex
@model TestRegexViewModel

<div class="card mt-4">
    <div class="card-header">
        <h4 class="card-title mb-0">
            <i class="fe fe-list"></i> Rule-by-Rule Results
            <span class="badge bg-secondary float-end">@Model.Results.Count rules</span>
        </h4>
    </div>
    <div class="card-body">
        <div class="accordion" id="ruleResultsAccordion">
            @foreach (var result in Model.Results.OrderBy(r => r.Order))
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading@(result.RuleId)">
                        <button class="accordion-button @(result.IsSuccess ? "" : "collapsed")"
                                type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapse@(result.RuleId)"
                                aria-expanded="@(result.IsSuccess ? "true" : "false")"
                                aria-controls="collapse@(result.RuleId)">
                            <div class="d-flex justify-content-between align-items-center w-100">
                                <div>
                                    <span class="badge @(result.IsSuccess ? "bg-success" : "bg-danger") me-2">
                                        @(result.IsSuccess ? "✓" : "✗")
                                    </span>
                                    <strong>@result.RuleType</strong> - Order: @result.Order
                                    @if (result.IsRequired)
                                    {
                                        <span class="badge bg-warning ms-2">Required</span>
                                    }
                                </div>
                                <div class="text-muted small">
                                    @if (!string.IsNullOrEmpty(result.ExtractedValue))
                                    {
                                        <span class="text-truncate" style="max-width: 200px;">Value: @result.ExtractedValue</span>
                                    }
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="collapse@(result.RuleId)"
                         class="accordion-collapse collapse @(result.IsSuccess ? "show" : "")"
                         aria-labelledby="heading@(result.RuleId)"
                         data-bs-parent="#ruleResultsAccordion">
                        <div class="accordion-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <h6>Rule Details</h6>
                                    <table class="table table-sm">
                                        <tr>
                                            <th>Pattern:</th>
                                            <td><code>@result.RegexPattern</code></td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(result.RegexGroupName))
                                        {
                                            <tr>
                                                <th>Group Name:</th>
                                                <td>@result.RegexGroupName</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrEmpty(result.FallbackValue))
                                        {
                                            <tr>
                                                <th>Fallback:</th>
                                                <td>@result.FallbackValue</td>
                                            </tr>
                                        }
                                        <tr>
                                            <th>Raw Match:</th>
                                            <td><code>@(result.RawMatch ?? "No match")</code></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <h6>Result</h6>
                                    @if (result.IsSuccess)
                                    {
                                        <div class="alert alert-success p-2">
                                            <i class="fe fe-check-circle"></i>
                                            <strong>Success!</strong>
                                            <div class="mt-1">
                                                Extracted: <strong>@result.ExtractedValue</strong>
                                            </div>

                                            <!-- Validation Status -->
                                            @if (!string.IsNullOrEmpty(result.ValidationLogic))
                                            {
                                                <div class="mt-2">
                                                    <div class="d-flex align-items-center">
                                                        @if (result.ValidationPassed)
                                                        {
                                                            <span class="badge bg-success me-2">Validation Passed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning me-2">Validation Failed</span>
                                                        }
                                                        <small class="text-muted">@result.ValidationLogic</small>
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(result.Notes))
                                            {
                                                <div class="mt-2 text-info">
                                                    <small><i class="fe fe-info"></i> @result.Notes</small>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-danger p-2">
                                            <i class="fe fe-alert-circle"></i>
                                            <strong>Failed!</strong>
                                            <div class="mt-1">@result.ErrorMessage</div>

                                            <!-- Show Validation Errors -->
                                            @if (result.ValidationErrors?.Any() == true)
                                            {
                                                <div class="mt-2">
                                                    <strong>Validation Errors:</strong>
                                                    <ul class="mb-0">
                                                        @foreach (var error in result.ValidationErrors)
                                                        {
                                                            <li>@error</li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Validation Errors Section -->
                                    @if (result.ValidationErrors?.Any() == true)
                                    {
                                        <div class="alert alert-warning mt-2">
                                            <h6><i class="fe fe-alert-triangle"></i> Validation Issues</h6>
                                            <ul class="mb-0">
                                                @foreach (var error in result.ValidationErrors)
                                                {
                                                    <li>@error</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Validation Logic Details -->
                            @if (!string.IsNullOrEmpty(result.ValidationLogic))
                            {
                                <div class="mt-3 border-top pt-2">
                                    <h6><i class="fe fe-filter"></i> Validation Rules</h6>
                                    <div class="bg-light p-2 rounded">
                                        <pre class="mb-0"><code>@result.ValidationLogic</code></pre>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>