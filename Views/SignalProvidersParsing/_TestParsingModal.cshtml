@using AutoSignals.ViewModels.ProviderRegex
@model TestRegexViewModel

<div class="modal fade" id="testParsingModal" tabindex="-1" aria-labelledby="testParsingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="testParsingModalLabel">
                    <i class="fe fe-play"></i> Test Parsing Rules
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_TestParsingContent", Model)
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary apply-values-btn">
                    <i class="fe fe-check-circle"></i> Apply Successful Values
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999"></div>