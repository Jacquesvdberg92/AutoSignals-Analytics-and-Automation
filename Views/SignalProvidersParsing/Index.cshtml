@model IEnumerable<AutoSignals.Models.SignalProvider>

@{
    ViewData["Title"] = "Signal Providers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Signal Providers</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Provider
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive text-muted">
                <table class="table table-hover" id="providersTable">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Name</th>
                            <th>Telegram Group</th>
                            <th>Rules</th>
                            <th>Created</th>
                            <th class="no-sort">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr data-provider-id="@item.Id">
                                <td>
                                    <div class="form-check form-switch">
                                        <input type="checkbox"
                                               class="form-check-input provider-toggle"
                                               data-provider-id="@item.Id"
                                               @(item.IsActive ? "checked" : "")
                                               role="switch">
                                        <label class="form-check-label">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </label>
                                    </div>
                                </td>
                                <td>@item.Name</td>
                                <td>
                                    <small class="text-muted">@item.TelegramGroupName</small><br>
                                    <code>@item.TelegramGroupId</code>
                                </td>
                                <td>
                                    <span class="badge bg-info">@item.ParsingRules.Count rules</span>
                                </td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="btn-group" role="group" aria-label="Provider actions">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="CreateRule" asp-route-providerId="@item.Id" class="btn btn-sm btn-outline-success" title="Add Rule">
                                            <i class="fas fa-plus-circle"></i>
                                        </a>
                                        <a asp-action="TestParsing" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Test Parsing">
                                            <i class="fas fa-vial"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger delete-provider-btn"
                                                data-provider-id="@item.Id"
                                                data-provider-name="@item.Name"
                                                title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteProviderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Signal Provider</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="providerNameToDelete"></strong>?</p>
                <p class="text-danger"><small>This action will delete all associated parsing rules and cannot be undone.</small></p>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="confirmDelete">
                    <label class="form-check-label" for="confirmDelete">
                        I understand this will permanently delete the provider and all its rules
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn" disabled>
                    <i class="fas fa-trash me-1"></i> Delete Provider
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
}

@section Scripts {
    <!-- Load jQuery first -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Then DataTables (which depends on jQuery) -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        document.body.dataset.toggleProviderStatusUrl = '@Url.Action("ToggleProviderStatus", "SignalProvidersParsing")';
        document.body.dataset.deleteProviderAjaxUrl = '@Url.Action("DeleteProviderAjax", "SignalProvidersParsing")';
    </script>

    <script src="~/assets/SignalProvidersParsing-js/index.js" asp-append-version="true"></script>
}