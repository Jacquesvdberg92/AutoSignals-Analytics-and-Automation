@model AutoSignals.Models.ProviderParsingRule

@{
    ViewData["Title"] = "Delete Rule";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3><i class="fe fe-trash-2"></i> @ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h4>Are you sure you want to delete this rule?</h4>
                        <p class="mb-0">This action cannot be undone. The associated signal provider will no longer use this rule.</p>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Provider:</dt>
                        <dd class="col-sm-9">@Model.Provider?.Name</dd>

                        <dt class="col-sm-3">Rule Type:</dt>
                        <dd class="col-sm-9">@Model.RuleType</dd>

                        <dt class="col-sm-3">Order:</dt>
                        <dd class="col-sm-9">@Model.Order</dd>

                        <dt class="col-sm-3">Regex Pattern:</dt>
                        <dd class="col-sm-9">
                            <code class="bg-light p-1 rounded">@Model.RegexPattern</code>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.RegexGroupName))
                        {
                            <dt class="col-sm-3">Group Name:</dt>
                            <dd class="col-sm-9">@Model.RegexGroupName</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.FallbackValue))
                        {
                            <dt class="col-sm-3">Fallback Value:</dt>
                            <dd class="col-sm-9">@Model.FallbackValue</dd>
                        }

                        <dt class="col-sm-3">Required Rule:</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsRequired)
                            {
                                <span class="badge bg-danger">Required</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Optional</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Created:</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <form asp-action="DeleteRuleConfirmed">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@Model.ProviderId"
                               class="btn btn-secondary">
                                <i class="fe fe-arrow-left"></i> Back to Edit
                            </a>

                            <button type="submit" class="btn btn-danger">
                                <i class="fe fe-trash-2"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}