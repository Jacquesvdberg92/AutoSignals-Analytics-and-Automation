@using AutoSignals.ViewModels.ProviderRegex
@model TestRegexViewModel

@{
    // Calculate validation statistics
    int totalRules = Model.Results?.Count ?? 0;
    int rulesWithValidation = Model.Results?.Count(r => !string.IsNullOrEmpty(r.ValidationLogic)) ?? 0;
    int validationPassed = Model.Results?.Count(r => r.ValidationPassed) ?? 0;
    int validationFailed = Model.Results?.Count(r => !r.ValidationPassed && !string.IsNullOrEmpty(r.ValidationLogic)) ?? 0;
    int validationErrors = Model.Results?.Sum(r => r.ValidationErrors?.Count ?? 0) ?? 0;
}

@if (totalRules > 0)
{
    <div class="card mt-4">
        <div class="card-header">
            <h4 class="card-title mb-0">
                <i class="fe fe-check-square"></i> Validation Summary
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="me-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 60px; height: 60px;">
                                <span class="h4 mb-0">@totalRules</span>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">Total Rules</h5>
                            <p class="text-muted mb-0">@rulesWithValidation with validation logic</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center p-3 border rounded">
                                <div class="h3 text-success mb-1">@validationPassed</div>
                                <div class="text-muted">Passed</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 border rounded">
                                <div class="h3 text-danger mb-1">@validationFailed</div>
                                <div class="text-muted">Failed</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (validationErrors > 0)
            {
                <div class="alert alert-warning mt-3">
                    <h6><i class="fe fe-alert-triangle"></i> Validation Issues Found</h6>
                    <ul class="mb-0">
                        @foreach (var result in Model.Results.Where(r => r.ValidationErrors?.Any() == true))
                        {
                            <li>
                                <strong>@result.RuleType (Order @result.Order):</strong>
                                <ul class="mb-2">
                                    @foreach (var error in result.ValidationErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            }
            else if (rulesWithValidation > 0)
            {
                <div class="alert alert-success mt-3">
                    <i class="fe fe-check-circle"></i>
                    <strong>All validations passed!</strong>
                    @validationPassed of @rulesWithValidation validation rules passed successfully.
                </div>
            }

            <!-- Quick Stats Table -->
            <div class="table-responsive mt-3">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Rule Type</th>
                            <th>Order</th>
                            <th>Required</th>
                            <th>Regex Match</th>
                            <th>Validation</th>
                            <th>Extracted Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in Model.Results.OrderBy(r => r.Order))
                        {
                            <tr>
                                <td>@result.RuleType</td>
                                <td>@result.Order</td>
                                <td>
                                    @if (result.IsRequired)
                                    {
                                        <span class="badge bg-warning">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Optional</span>
                                    }
                                </td>
                                <td>
                                    @if (result.IsSuccess)
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(result.ValidationLogic))
                                    {
                                        if (result.ValidationPassed)
                                        {
                                            <span class="badge bg-success">Passed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Failed</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No validation</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(result.ExtractedValue))
                                    {
                                        <code>@result.ExtractedValue</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}