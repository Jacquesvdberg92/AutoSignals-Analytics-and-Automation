@model AutoSignals.ViewModels.EmailBroadcastViewModel
@{
    ViewData["Title"] = "Email Broadcast";
}

@section styles {
    <link rel="stylesheet" href="@Url.Content("~/assets/libs/quill/quill.snow.css")">
    <style>
        #quill-editor { min-height: 280px; background: #fff; color: #212529; font-size: .9rem; }
        .ql-toolbar.ql-snow { border-radius: .375rem .375rem 0 0; }
        .ql-container.ql-snow { border-radius: 0 0 .375rem .375rem; }
        #recipient-picker { transition: opacity .2s; }
        #recipient-picker.dimmed { opacity: .4; pointer-events: none; user-select: none; }
    </style>
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between page-header-breadcrumb flex-wrap gap-2 mb-4">
    <div>
        <nav>
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page">Email Broadcast</li>
            </ol>
        </nav>
        <h1 class="page-title fw-medium fs-18 mb-0">Email Broadcast</h1>
    </div>
</div>

@if (TempData["Status"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="ri-checkbox-circle-line me-2"></i> @TempData["Status"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Send" method="post" id="broadcastForm">
    <div class="row g-4">

        <!-- LEFT: Compose -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold fs-14 border-bottom">
                    <i class="ri-mail-send-line me-1 text-primary"></i> Compose Message
                </div>
                <div class="card-body d-flex flex-column gap-3">

                    <div>
                        <label asp-for="Subject" class="form-label fw-medium fs-13"></label>
                        <input asp-for="Subject" class="form-control" placeholder="Email subject..." />
                        <span asp-validation-for="Subject" class="text-danger fs-12"></span>
                    </div>

                    <div>
                        <label class="form-label fw-medium fs-13">Body</label>
                        <!-- Quill visible editor -->
                        <div id="quill-editor"></div>
                        <!-- Hidden textarea submitted with the form -->
                        <textarea asp-for="HtmlBody" id="HtmlBody" class="d-none"></textarea>
                        <span asp-validation-for="HtmlBody" class="text-danger fs-12"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT: Options & Recipients -->
        <div class="col-lg-4 d-flex flex-column gap-4">

            <!-- Send options -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold fs-14 border-bottom">
                    <i class="ri-settings-3-line me-1 text-warning"></i> Send Options
                </div>
                <div class="card-body d-flex flex-column gap-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" asp-for="IsTest" />
                        <label class="form-check-label" asp-for="IsTest"></label>
                        <div class="text-muted fs-12 mt-1">Sends only to your own account for previewing.</div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" asp-for="SendToAll" id="SendToAll" />
                        <label class="form-check-label" asp-for="SendToAll"></label>
                        <div class="text-muted fs-12 mt-1">Ignores the recipient table and targets every confirmed user.</div>
                    </div>
                </div>
            </div>

            <!-- Recipients -->
            <div class="card border-0 shadow-sm flex-fill">
                <div class="card-header bg-transparent fw-semibold fs-14 border-bottom d-flex justify-content-between align-items-center">
                    <span><i class="ri-group-line me-1 text-success"></i> Recipients</span>
                    <span id="recipientBadge" class="badge bg-primary-transparent text-primary fs-12">0 selected</span>
                </div>
                <div class="card-body p-0">
                    <div id="recipient-picker">
                        <div class="px-3 pt-3 pb-2">
                            <input type="text" id="recipientSearch" class="form-control form-control-sm" placeholder="Search users...">
                        </div>
                        <div class="px-3 pb-2 d-flex gap-2">
                            <button type="button" id="selectAll" class="btn btn-outline-secondary btn-sm">Select All</button>
                            <button type="button" id="deselectAll" class="btn btn-outline-secondary btn-sm">Deselect All</button>
                        </div>
                        <div class="table-responsive" style="max-height:320px;overflow-y:auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr><th style="width:36px"></th><th>User</th><th>Email</th></tr>
                                </thead>
                                <tbody id="recipientTable">
                                    @foreach (var r in Model.Recipients)
                                    {
                                        <tr class="recipient-row" data-name="@r.UserName?.ToLower()" data-email="@r.Email?.ToLower()">
                                            <td>
                                                <input type="checkbox" name="SelectedRecipientIds" value="@r.Id"
                                                       class="form-check-input recipient-check" />
                                            </td>
                                            <td class="fs-13">@r.UserName</td>
                                            <td class="fs-13 text-muted">@r.Email</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Send bar -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body d-flex justify-content-end gap-2 py-3">
            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('broadcastForm').reset(); quillEditor.setText('');">
                <i class="ri-refresh-line me-1"></i> Clear
            </button>
            <button type="submit" class="btn btn-primary px-4">
                <i class="ri-send-plane-line me-1"></i> Send Email
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="@Url.Content("~/assets/libs/quill/quill.js")"></script>
    <script>
        // ── Quill setup ──────────────────────────────────────────────────────
        var quillEditor = new Quill('#quill-editor', {
            theme: 'snow',
            placeholder: 'Type your email body here...',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    [{ font: [] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ color: [] }, { background: [] }],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    [{ align: [] }],
                    ['link'],
                    ['clean']
                ]
            }
        });

        // Pre-fill editor if model has existing content (validation round-trip)
        (function () {
            var existing = document.getElementById('HtmlBody').value;
            if (existing) quillEditor.clipboard.dangerouslyPasteHTML(existing);
        })();

        // Sync Quill HTML → hidden textarea before submit
        document.getElementById('broadcastForm').addEventListener('formdata', function (e) {
            e.formData.set('HtmlBody', quillEditor.root.innerHTML);
        });
        // Fallback for browsers without FormDataEvent
        document.getElementById('broadcastForm').addEventListener('submit', function () {
            document.getElementById('HtmlBody').value = quillEditor.root.innerHTML;
        });

        // ── Recipient table ──────────────────────────────────────────────────
        const checks = () => Array.from(document.querySelectorAll('.recipient-check'));
        const badge  = document.getElementById('recipientBadge');

        function updateBadge() {
            const n = checks().filter(c => c.checked).length;
            badge.textContent = n + ' selected';
        }

        document.getElementById('selectAll').addEventListener('click', function () {
            checks().forEach(c => { if (c.closest('tr').style.display !== 'none') c.checked = true; });
            updateBadge();
        });
        document.getElementById('deselectAll').addEventListener('click', function () {
            checks().forEach(c => c.checked = false);
            updateBadge();
        });
        document.querySelectorAll('.recipient-check').forEach(c => c.addEventListener('change', updateBadge));

        document.getElementById('recipientSearch').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.recipient-row').forEach(row => {
                const match = !q || row.dataset.name.includes(q) || row.dataset.email.includes(q);
                row.style.display = match ? '' : 'none';
            });
        });

        // Dim recipient picker when "Send to All" is toggled on
        const sendToAllToggle = document.getElementById('SendToAll');
        const recipientPicker = document.getElementById('recipient-picker');

        function syncRecipientPicker() {
            recipientPicker.classList.toggle('dimmed', sendToAllToggle.checked);
        }
        sendToAllToggle.addEventListener('change', syncRecipientPicker);
        syncRecipientPicker();

        updateBadge();
    </script>
}

