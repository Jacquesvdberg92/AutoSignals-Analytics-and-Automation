@{
    ViewData["Title"] = "Analytics Dashboard";
    var exchanges = ViewBag.Exchanges as IEnumerable<AutoSignals.Models.Exchange>;
    var providerViews = ViewBag.ProviderViews as IEnumerable<dynamic>;
    var providersLastSignalDate = ViewBag.ProvidersLastSignalDate as IEnumerable<dynamic>;
    var pageBreakdown = ViewBag.PageBreakdown as IEnumerable<dynamic>;
    var topPages = ViewBag.TopPages as IEnumerable<dynamic>;
    var topIps = ViewBag.TopIps as IEnumerable<dynamic>;
    var dbTableSizes = ViewBag.DbTableSizes as IEnumerable<dynamic>;
    var recentVisits = ViewBag.RecentVisits as IEnumerable<AutoSignals.Models.UserVisit>;
    var userCounts = ViewBag.UserCounts;

    // Stat card values
    decimal totalDbMb = ViewBag.TotalDbMb is decimal dv ? dv : 0m;
    string dbSizeDisplay = totalDbMb >= 1024m
        ? $"{Math.Round(totalDbMb / 1024m, 1)} GB"
        : $"{Math.Round(totalDbMb, 0)} MB";

    int visitCount7Days = ViewBag.VisitCount7Days is int vc ? vc : 0;

    decimal bandwidthMb = ViewBag.BandwidthMb30Days is decimal bw ? bw : 0m;
    string bandwidthDisplay = bandwidthMb >= 1024m
        ? $"{Math.Round(bandwidthMb / 1024m, 1)} GB"
        : $"{Math.Round(bandwidthMb, 0)} MB";

    int errorCount7Days = ViewBag.ErrorCount7Days is int ec ? ec : 0;

    // Chart JSON data
    string visitDatesJson = ViewBag.DailyVisitDatesJson as string ?? "[]";
    string visitCountsJson = ViewBag.DailyVisitCountsJson as string ?? "[]";
    string viewDatesJson = ViewBag.DailyViewsDatesJson as string ?? "[]";
    string viewCountsJson = ViewBag.DailyViewsCountsJson as string ?? "[]";

    // Max values for progress bars
    int maxPageCount = 1;
    if (topPages != null)
        foreach (var p in topPages)
        {
            int c = (int)p.Count;
            if (c > maxPageCount) maxPageCount = c;
        }

    decimal maxTableMb = 1m;
    if (dbTableSizes != null)
        foreach (var t in dbTableSizes)
        {
            decimal m = (decimal)t.SizeMb;
            if (m > maxTableMb) maxTableMb = m;
            break; // first row is largest (ordered DESC)
        }
}

@section styles { }

<!-- Start::page-header -->
<div class="d-flex align-items-center justify-content-between page-header-breadcrumb flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page">Analytics</li>
            </ol>
        </nav>
        <h1 class="page-title fw-medium fs-18 mb-0">Analytics Dashboard</h1>
    </div>
    <div class="btn-list">
        <a asp-action="Index" class="btn btn-white btn-wave">
            <i class="ri-refresh-line align-middle me-1 lh-1"></i> Refresh
        </a>
