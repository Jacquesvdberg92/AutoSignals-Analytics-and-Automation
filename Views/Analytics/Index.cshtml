<!-- Start::row-3 -->
<div class="row">
    <!-- Exchange referrals + Top IPs -->
    <div class="col-xxl-5">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">Exchange Referral Clicks</div>
                <a href="javascript:void(0);" class="btn btn-light btn-wave btn-sm text-muted waves-effect waves-light">View All</a>
            </div>
            <div class="card-body d-sm-flex align-items-start gap-3">
                <div class="flex-fill">
                    <div class="table-responsive">
                        <table class="table table-bordered text-nowrap mb-0">
                            <thead>
                                <tr>
                                    <th>Exchange</th>
                                    <th class="text-center">Clicks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (exchanges != null)
                                {
                                    foreach (var ex in exchanges)
                                    {
                                        <tr>
                                            <td>@ex.Name</td>
                                            <td class="text-center fw-medium">@ex.ReferalClicked</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="flex-fill">
                    <p class="fw-medium mb-2 fs-13">Top Visitor IPs <span class="badge bg-light text-muted fw-medium ms-1">30d</span></p>
                    @if (topIps != null)
                    {
                        <ul class="list-unstyled mb-0 analytics-visitors-countries">
                            @foreach (var ip in topIps)
                            {
                                <li class="mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="flex-fill lh-1">
                                            <span class="fs-13 text-truncate d-block" style="max-width:130px" title="@ip.Ip">@ip.Ip</span>
                                        </div>
                                        <span class="badge bg-light text-default fw-medium">@((int)ip.Count)</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted fs-13 mb-0">Data accumulates as users visit.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Top Visited Pages (from UserVisits) -->
    <div class="col-xxl-4">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <h5 class="card-title">Top Visited Pages</h5>
                <span class="badge bg-light text-muted fw-medium fs-11">Last 30 days</span>
            </div>
            <div class="card-body">
                @if (topPages != null)
                {
                    string[] barColors = { "bg-primary", "bg-primary1", "bg-primary2", "bg-primary3", "bg-info", "bg-warning", "bg-success", "bg-secondary", "bg-danger", "bg-dark" };
                    int idx = 0;
                    foreach (var p in topPages)
                    {
                        string pageName = (string)p.Page ?? "/";
                        int count = (int)p.Count;
                        int w = maxPageCount > 0 ? (int)Math.Min(100, Math.Round((double)count / maxPageCount * 100)) : 0;
                        string barColor = barColors[idx % barColors.Length];
                        <div class="mb-3">
                            <div class="d-flex mb-1">
                                <span class="fs-12 text-truncate" style="max-width:220px" title="@pageName">@pageName</span>
                                <span class="ms-auto fs-13 fw-semibold">@count.ToString("N0") visits</span>
                            </div>
                            <div class="progress progress-md p-1">
                                <div class="progress-bar progress-bar-striped progress-bar-animated @barColor" role="progressbar" style="width:@(w)%" aria-valuenow="@w" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                        idx++;
                    }
                }
                else
                {
                    <p class="text-muted fs-13 mb-0">Data accumulates as users browse the site.</p>
                }
            </div>
        </div>
    </div>

    <!-- Signal providers quick stats -->
    <div class="col-xxl-3">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">Provider Views (30d)</div>
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0 analytics-visitors-countries">
                    @if (providerViews != null)
                    {
                        foreach (var pv in providerViews)
                        {
                            <li class="mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="flex-fill lh-1">
                                        <span class="fs-14 d-block text-truncate" style="max-width:120px" title="@pv.Name">@pv.Name</span>
                                    </div>
                                    <span class="text-default badge bg-light fw-medium">@((int)pv.Views)</span>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End::row-3 -->

<!-- Start::row-4 -->
<div class="row">
    <!-- Provider signal dates -->
    <div class="col-xxl-5">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">Signal Provider Activity</div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap table-bordered">
                        <thead>
                            <tr>
                                <th>Provider</th>
                                <th>Last Signal</th>
                                <th class="text-center">30d Views</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (providersLastSignalDate != null)
                            {
                                foreach (var sd in providersLastSignalDate)
                                {
                                    DateTime? last = null;
                                    if (sd?.LastSignalDate != null)
                                    {
                                        try { last = (DateTime)sd.LastSignalDate; }
                                        catch { last = Convert.ToDateTime(sd.LastSignalDate); }
                                    }
                                    string css = "";
                                    if (last.HasValue)
                                    {
                                        var lastUtc = last.Value.Kind == DateTimeKind.Utc ? last.Value : DateTime.SpecifyKind(last.Value, DateTimeKind.Utc);
                                        var ageDays = (DateTime.UtcNow - lastUtc).TotalDays;
                                        if (ageDays > 30) css = "text-danger";
                                        else if (ageDays > 7) css = "text-warning";
                                    }
                                    var displayText = last.HasValue ? last.Value.ToString("yyyy-MM-dd HH:mm") : "—";
                                    var views = providerViews?.FirstOrDefault(p => (string)p.Name == (string)sd.Name);
                                    var viewCount = views != null ? (int)views.Views : 0;
                                    <tr>
                                        <td>@sd.Name</td>
                                        <td class="@css">@displayText</td>
                                        <td class="text-center">@viewCount</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics page-view breakdown -->
    <div class="col-xxl-7">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">Page View Breakdown (30 days)</div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap table-bordered">
                        <thead>
                            <tr>
                                <th>Page</th>
                                <th class="text-end">Views</th>
                                <th>Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pageBreakdown != null)
                            {
                                int totalViews = 1;
                                foreach (var p in pageBreakdown) totalViews += (int)p.TotalViews;
                                foreach (var p in pageBreakdown.Take(15))
                                {
                                    int pct = (int)Math.Round((double)(int)p.TotalViews / totalViews * 100);
                                    <tr>
                                        <td class="text-truncate" style="max-width:300px" title="@p.PageName">@p.PageName</td>
                                        <td class="text-end fw-medium">@((int)p.TotalViews)</td>
                                        <td style="min-width:80px">
                                            <div class="progress" style="height:6px;">
                                                <div class="progress-bar bg-primary" style="width:@(pct)%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End::row-4 -->

<!-- Start::row-5 recent visits -->
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">Recent Visits</div>
                <span class="badge bg-light text-muted fw-medium fs-11">Last 50 tracked requests</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover text-nowrap table-bordered">
                        <thead>
                            <tr>
                                <th>Time (UTC)</th>
                                <th>IP Address</th>
                                <th>Page</th>
                                <th>User</th>
                                <th class="text-end">Bytes Sent</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentVisits != null && recentVisits.Any())
                            {
                                foreach (var v in recentVisits)
                                {
                                    string bytesDisplay = v.BytesSent >= 1_048_576
                                        ? $"{v.BytesSent / 1_048_576:N1} MB"
                                        : v.BytesSent >= 1024
                                            ? $"{v.BytesSent / 1024:N0} KB"
                                            : v.BytesSent > 0 ? $"{v.BytesSent} B" : "—";
                                    <tr>
                                        <td>@v.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@(v.IpAddress ?? "—")</td>
                                        <td class="text-truncate" style="max-width:300px" title="@v.PagePath">@(v.PagePath ?? "—")</td>
                                        <td>@(v.UserId != null ? v.UserId[..Math.Min(8, v.UserId.Length)] + "…" : "Guest")</td>
                                        <td class="text-end">@bytesDisplay</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">
                                        No visit data yet — data accumulates as users browse the site.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End::row-5 -->

@section scripts {
    <script src="@Url.Content("~/assets/libs/apexcharts/apexcharts.min.js")"></script>
    <script>
        (function () {
            var viewDates = @Html.Raw(viewDatesJson);
            var viewCounts = @Html.Raw(viewCountsJson);
            var visitDates = @Html.Raw(visitDatesJson);
            var visitCounts = @Html.Raw(visitCountsJson);

            // Merge date axes
            var allSet = {};
            viewDates.forEach(function (d) { allSet[d] = true; });
            visitDates.forEach(function (d) { allSet[d] = true; });
            var allDates = Object.keys(allSet).sort();

            var viewMap = {};
            viewDates.forEach(function (d, i) { viewMap[d] = viewCounts[i]; });
            var visitMap = {};
            visitDates.forEach(function (d, i) { visitMap[d] = visitCounts[i]; });

            var mergedViewCounts = allDates.map(function (d) { return viewMap[d] || 0; });
            var mergedVisitCounts = allDates.map(function (d) { return visitMap[d] || 0; });

            var options = {
                series: [
                    { name: 'Page Views', data: mergedViewCounts },
                    { name: 'HTTP Visits', data: mergedVisitCounts }
                ],
                chart: {
                    type: 'area',
                    height: 300,
                    toolbar: { show: false },
                    zoom: { enabled: false }
                },
                dataLabels: { enabled: false },
                stroke: { curve: 'smooth', width: 2 },
                xaxis: {
                    categories: allDates,
                    labels: { rotate: -30, style: { fontSize: '10px' } },
                    tickAmount: 10
                },
                yaxis: {
                    labels: { formatter: function (v) { return Math.floor(v); } }
                },
                fill: {
                    type: 'gradient',
                    gradient: { opacityFrom: 0.35, opacityTo: 0 }
                },
                legend: { position: 'top' },
                grid: { borderColor: '#e9edf4' },
                colors: ['#6366f1', '#06b6d4'],
                tooltip: { x: { show: true } }
            };

            new ApexCharts(document.querySelector('#activity-chart'), options).render();
        })();
    </script>
}
