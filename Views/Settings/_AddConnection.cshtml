@model AutoSignals.ViewModels.ConnectionFormViewModel

<div class="modal fade" id="addConnectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plug me-2"></i>Add Exchange Connection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addConnectionForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-medium">Exchange <span class="text-danger">*</span></label>
                        <select name="exchangeId" class="form-select" required>
                            <option value="">Select exchange…</option>
                            @foreach (var ex in Model.AvailableExchanges)
                            {
                                <option value="@ex.Value">@ex.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">Label</label>
                        <input name="label" class="form-control" type="text" placeholder="e.g. Main Bitget" maxlength="100" />
                        <small class="text-muted">Optional friendly name for this connection.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">API Key <span class="text-danger">*</span></label>
                        <input name="apiKeyInput" class="form-control" type="password" autocomplete="new-password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">API Secret <span class="text-danger">*</span></label>
                        <input name="apiSecretInput" class="form-control" type="password" autocomplete="new-password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-medium">API Password</label>
                        <input name="apiPasswordInput" class="form-control" type="password" autocomplete="new-password" />
                        <small class="text-muted">Required by some exchanges (e.g. OKX).</small>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input name="isDefault" class="form-check-input" type="checkbox" id="addIsDefault" value="true" />
                        <label class="form-check-label" for="addIsDefault">Set as default connection</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveAddConnection">
                    <i class="bi bi-floppy me-1"></i>Save Connection
                </button>
            </div>
        </div>
    </div>
</div>
