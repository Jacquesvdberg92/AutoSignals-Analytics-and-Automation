@model AutoSignals.ViewModels.UserProfileViewModel

@section styles {
    <!-- Glightbox CSS -->
    <link rel="stylesheet" href="@Url.Content("~/assets/libs/glightbox/css/glightbox.min.css")">
}

<form id="settingsAntiforgeryForm" class="d-none" aria-hidden="true">
    @Html.AntiForgeryToken()
</form>

<!-- Start:: row-1 -->
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card profile-card">
            <div class="">
                <img src="@Url.Content("~/assets/images/media/Banner.jpeg")" class="card-img-top" alt="...">
            </div>
            <div class="card-body pb-0 position-relative">
                <div class="row profile-content">
                    <div class="col-xl-3">
                        <div class="card custom-card overflow-hidden border">
                            <div class="card-body border-bottom border-block-end-dashed">
                                <div class="text-center">
                                    <span class="avatar avatar-xxl avatar-rounded online mb-3">
                                        <img src="@Url.Content("~/assets/images/faces/15.jpg")" alt="">
                                    </span>
                                    <h5 class="fw-semibold mb-1">@Html.DisplayFor(model => model.UserData.NickName)</h5>
                                    <span class="d-block fw-medium text-muted mb-2">@string.Join(", ", Model.Roles)</span>
                                </div>
                            </div>
                            <div class="d-flex mb-0 flex-wrap gap-3 p-3 border-bottom border-block-end-dashed">
                                <div class="border-dashed rounded text-center flex-fill">
                                    <div class="main-card-icon mb-2 primary1">
                                        <div class="avatar avatar-sm bg-primary1">
                                            <i class="fs-15 bi bi-graph-up-arrow"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 justify-content-center align-items-end">
                                        <p class="fw-semibold fs-20 mb-0">@Model.OpenPositionCount</p>
                                        <p class="mb-1 text-muted">Open Positions</p>
                                    </div>
                                </div>
                                <div class="border-dashed rounded text-center flex-fill">
                                    <div class="main-card-icon mb-2 secondary">
                                        <div class="avatar avatar-sm bg-secondary">
                                            <i class="fs-15 bi bi-lock-fill"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 justify-content-center align-items-end">
                                        <p class="fw-semibold fs-20 mb-0">@Model.PositionCount</p>
                                        <p class="mb-1 text-muted">All Positions</p>
                                    </div>
                                </div>
                            </div>
                            <div class="p-3 pb-1 d-flex flex-wrap justify-content-between">
                                <div class="fw-medium fs-15 text-primary1">
                                    Basic Info :
                                </div>
                            </div>
                            <div class="card-body border-block-end-dashed p-0">
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item pt-2 border-0">
                                        <div><span class="fw-medium me-2">User Name :</span><span class="text-muted">@Model.User.UserName</span></div>
                                    </li>
                                    <li class="list-group-item pt-2 border-0">
                                        <div><span class="fw-medium me-2">Designation :</span><span class="text-muted">@string.Join(", ", Model.Roles)</span></div>
                                    </li>
                                    <li class="list-group-item pt-2 border-0">
                                        <div><span class="fw-medium me-2">Email :</span><span class="text-muted">@Model.User.Email</span></div>
                                    </li>
                                    <li class="list-group-item pt-2 border-0">
                                        <div><span class="fw-medium me-2">Phone :</span><span class="text-muted">@Model.User.PhoneNumber</span></div>
                                    </li>
                                    <li class="list-group-item pt-2 border-0">
                                        <div><span class="fw-medium me-2">Telegram ID :</span><span class="text-muted">@Model.UserData.TelegramId</span></div>
                                    </li>
                                    <li class="list-group-item pt-2 border-0">
                                        <div><span class="fw-medium me-2">Member Since :</span><span class="text-muted">@Model.UserData.Time.ToString("yyyy-MM-dd")</span></div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-9">
                        <div class="card custom-card overflow-hidden border">
                            <div class="card-body">
                                @* // -- Tab headers -- // *@
                                <ul class="nav nav-tabs tab-style-6 mb-3 p-0" id="myTab" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link w-100 text-start active" id="provider-settings--tab" data-bs-toggle="tab"
                                                data-bs-target="#provider-settings-tab-pane" type="button" role="tab"
                                                aria-controls="provider-settings-tab-pane" aria-selected="true">
                                            Provider Settings
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link w-100 text-start" id="edit-profile-tab" data-bs-toggle="tab"
                                                data-bs-target="#edit-profile-tab-pane" type="button" role="tab"
                                                aria-controls="edit-profile-tab-pane" aria-selected="true">
                                            Edit API Connection
                                        </button>
                                    </li>
                                </ul>
                                <div class="tab-content" id="profile-tabs">
                                    @* // -- Provider Settings -- // *@
                                    <div class="tab-pane show active p-0 border-0" id="provider-settings-tab-pane" role="tabpanel"
                                         aria-labelledby="provider-settings-tab" tabindex="0">

                                        <!-- Bulk Actions Toolbar -->
                                        @* <div class="card mb-3">
                                            <div class="card-body">
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <h6 class="mb-0">Bulk Actions:</h6>
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-outline-primary btn-sm" id="bulkEnable">
                                                            <i class="bi bi-toggle-on me-1"></i>Enable Selected
                                                        </button>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="bulkDisable">
                                                            <i class="bi bi-toggle-off me-1"></i>Disable Selected
                                                        </button>
                                                    </div>
                                                    <div class="form-check form-switch ms-auto">
                                                        <input class="form-check-input" type="checkbox" id="toggleAll">
                                                        <label class="form-check-label" for="toggleAll">Select All</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div> *@

                                        <!-- Quick Settings Summary -->
                                        <div class="mt-3 p-3 border rounded bg-light">
                                            <h6 class="mb-2">Quick Settings Summary</h6>
                                            <div class="row g-2">
                                                <div class="col-md-3">
                                                    <small class="text-muted">Active Providers:</small>
                                                    <span class="fw-medium ms-1">@Model.ProviderSettings.Count(p => p.IsEnabled)</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted">Average Risk:</small>
                                                    <span class="fw-medium ms-1">
                                                        @{
                                                            var avgRisk = Model.ProviderSettings.Where(p => p.IsEnabled).Select(p => (double?)p.RiskPercentage).Average();
                                                        }
                                                        @(avgRisk.HasValue? avgRisk.Value.ToString("0.0") : "N/A")%
                                                    </span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted">Testing Mode:</small>
                                                    <span class="fw-medium ms-1">@Model.ProviderSettings.Count(p => p.Testing)</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted">Moonbag Enabled:</small>
                                                    <span class="fw-medium ms-1">@Model.ProviderSettings.Count(p => p.UseMoonbag)</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Providers Table -->
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="table-responsive">
                                                    <table class="table table-hover" id="providersTable">
                                                        <thead>
                                                            <tr>
                                                                @* <th width="50">
                                                                    <input type="checkbox" id="selectAll" class="form-check-input">
                                                                </th> *@
                                                                <th>Provider</th>
                                                                <th>Status</th>
                                                                <th>Risk %</th>
                                                                <th>Leverage</th>
                                                                <th>TP Levels</th>
                                                                <th>Trade Size</th>
                                                                <th>Filters</th>
                                                                <th class="text-end">Actions</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var provider in Model.ProviderSettings)
                                                            {
                                                                <tr data-provider-id="@provider.ProviderId">
                                                                   @*  <td>
                                                                        <input type="checkbox" class="provider-checkbox form-check-input" value="@provider.ProviderId">
                                                                    </td> *@
                                                                    <td>
                                                                        <div class="d-flex align-items-center">
                                                                            <div class="avatar avatar-xs me-2">
                                                                                <span class="avatar-initial rounded-circle bg-primary">
                                                                                    @provider.ProviderId.ToString()[0]
                                                                                </span>
                                                                            </div>
                                                                            <span class="fw-medium">Provider @provider.ProviderId</span>
                                                                        </div>
                                                                    </td>
                                                                    <td>
                                                                        <span class="badge @(provider.IsEnabled ? "bg-success" : "bg-secondary")">
                                                                            @(provider.IsEnabled ? "Active" : "Inactive")
                                                                        </span>
                                                                        @if (provider.Testing)
                                                                        {
                                                                            <span class="badge bg-warning ms-1">Testing</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <span class="fw-medium">@provider.RiskPercentage%</span>
                                                                    </td>
                                                                    <td>
                                                                        <span class="fw-medium">@provider.Leverage<span class="text-muted fs-11">x</span></span>
                                                                    </td>
                                                                    <td>
                                                                        @if (provider.TpPercentages != null && provider.TpPercentages.Any())
                                                                        {
                                                                            @string.Join("/", provider.TpPercentages.Select(p => $"{p}%"))
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted">None</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <small class="text-muted">$@provider.MinTradeSizeUsd - $@provider.MaxTradeSizeUsd</small>
                                                                    </td>
                                                                    <td>
                                                                        <div class="d-flex gap-1">
                                                                            @if (provider.IgnorLong)
                                                                            {
                                                                                <span class="badge bg-info">No Long</span>
                                                                            }
                                                                            @if (provider.IgnorShort)
                                                                            {
                                                                                <span class="badge bg-info">No Short</span>
                                                                            }
                                                                        </div>
                                                                    </td>
                                                                    <td class="text-end">
                                                                        <div class="btn-group btn-group-sm">
                                                                            <button type="button" class="btn btn-outline-primary edit-provider"
                                                                                    data-provider-id="@provider.ProviderId">
                                                                                <i class="bi bi-pencil-square"></i>
                                                                            </button>
                                                                            <button type="button" class="btn btn-outline-success toggle-provider"
                                                                                    data-provider-id="@provider.ProviderId"
                                                                                    data-enabled="@provider.IsEnabled">
                                                                                <i class="bi bi-power"></i>
                                                                            </button>
                                                                            @* <button type="button" class="btn btn-outline-info quick-copy"
                                                                                    data-provider-id="@provider.ProviderId"
                                                                                    title="Copy settings to others">
                                                                                <i class="bi bi-copy"></i>
                                                                            </button> *@
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>

                                                
                                            </div>
                                        </div>

                                        <!-- Include the modal partial -->
                                        @* <partial name="_ProviderSettingsModal" /> *@
                                        <!-- Empty modal placeholder - will be populated via AJAX -->
                                        <div id="providerSettingsModalPlaceholder"></div>
                                    </div>
                                    <div class="tab-pane p-0 border-0" id="edit-profile-tab-pane" role="tabpanel"
                                         aria-labelledby="edit-profile-tab" tabindex="0">
                                        <form asp-action="UpdateUserDetails" method="post" autocomplete="off">
                                            <input type="hidden" asp-for="User.Id" />
                                            <input type="hidden" asp-for="UserData.Id" />
                                            <ul class="list-group list-group-flush border rounded-3">
                                                <li class="list-group-item p-3">
                                                    <span class="fw-medium fs-15 d-block mb-3">Exchange Info :</span>
                                                    <div class="row gy-3 align-items-center">
                                                        <div class="col-xl-3">
                                                            <div class="lh-1">
                                                                <span class="fw-medium">Exchange :</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-9">
                                                            <select asp-for="UserData.ExchangeId" class="form-control" asp-items="@(new SelectList(Model.AvailableExchanges, "Value", "Text"))" autocomplete="off"></select>
                                                        </div>
                                                        <div class="col-xl-3">
                                                            <div class="lh-1">
                                                                <span class="fw-medium">API Key :</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-9">
                                                            <input asp-for="ApiKeyInput" class="form-control" type="password" autocomplete="new-password" />
                                                        </div>
                                                        <div class="col-xl-3">
                                                            <div class="lh-1">
                                                                <span class="fw-medium">API Secret :</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-9">
                                                            <input asp-for="ApiSecretInput" class="form-control" type="password" autocomplete="new-password" />
                                                        </div>
                                                        <div class="col-xl-3">
                                                            <div class="lh-1">
                                                                <span class="fw-medium">API Password :</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-9">
                                                            <input asp-for="ApiPasswordInput" class="form-control" type="password" autocomplete="new-password" />
                                                        </div>
                                                        <span class="fw-medium text-default">API Validated : </span>
                                                        <span class="badge @(Model.UserData.ApiTestResult == "1" ? "bg-outline-success" : "bg-outline-warning")">
                                                            @(Model.UserData.ApiTestResult == "1" ? "Successful - API was saved and Tested" : "Failed - Invalid API data provided")
                                                        </span>
                                                    </div>
                                                </li>
                                            </ul>
                                            <div class="p-2 text-end">
                                                <button type="submit" class="btn btn-primary p-2">Update</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End:: row-1 -->
@section scripts {
    <!-- Load jQuery FIRST -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Then DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- SweetAlert2 for better alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Provider Settings Page Script -->
    <script src="~/js/ProviderSettings-js/provider-settings.js"></script>
}
