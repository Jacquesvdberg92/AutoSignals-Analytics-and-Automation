@model List<AutoSignals.Models.SubscriptionPlan>
@using AutoSignals.Models
@{
    Layout = "~/Views/Shared/_LayoutLan.cshtml";
    var proMonthly = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.Pro && !p.IsAnnual);
    var proAnnual  = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.Pro && p.IsAnnual);
    var vipMonthly = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.VIP && !p.IsAnnual);
    var vipAnnual  = Model?.FirstOrDefault(p => p.Tier == SubscriptionTier.VIP && p.IsAnnual);
}

@section styles {
    <style>
        /* ============================================================
           AUTOSIGNALS LANDING PAGE — CRO-OPTIMISED STYLES
           ============================================================ */

        /* ── Scroll Reveal ── */
        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.65s ease, transform 0.65s ease;
        }
        .reveal.visible { opacity: 1; transform: translateY(0); }
        .reveal-delay-1 { transition-delay: 0.10s; }
        .reveal-delay-2 { transition-delay: 0.20s; }
        .reveal-delay-3 { transition-delay: 0.30s; }

        /* ── Live Pulse Badge ── */
        .hero-live-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.22);
            backdrop-filter: blur(8px);
            border-radius: 50px;
            padding: 6px 18px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #fff;
            margin-bottom: 1.4rem;
        }
        .pulse-dot {
            width: 8px; height: 8px;
            background: #22c55e;
            border-radius: 50%;
            flex-shrink: 0;
            animation: pulse-green 1.6s infinite;
        }
        @@keyframes pulse-green {
            0%   { box-shadow: 0 0 0 0   rgba(34,197,94,0.55); }
            70%  { box-shadow: 0 0 0 9px rgba(34,197,94,0); }
            100% { box-shadow: 0 0 0 0   rgba(34,197,94,0); }
        }

        /* ── Typing cursor ── */
        .typing-cursor::after {
            content: '|';
            animation: blink 0.7s step-start infinite;
            color: #fbbf24;
        }
        @@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

        /* ── Hero stat counters ── */
        .hero-stats {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0;
            margin-top: 1.5rem;
        }
        .stat-item { text-align: center; padding: 0.4rem 1.4rem; }
        .stat-number {
            font-size: 2rem; font-weight: 800;
            color: #fff; line-height: 1; display: block;
        }
        .stat-label {
            font-size: 0.72rem; color: rgba(255,255,255,0.65);
            text-transform: uppercase; letter-spacing: 0.5px; margin-top: 3px;
        }
        .stat-divider {
            width: 1px; height: 38px;
            background: rgba(255,255,255,0.18);
            align-self: center;
        }

        /* ── Exchange trust bar ── */
        .trust-bar {
            background: rgba(0,0,0,0.18);
            border-top: 1px solid rgba(255,255,255,0.09);
            padding: 14px 0;
        }
        .trust-bar-inner {
            display: flex; align-items: center;
            justify-content: center;
            gap: 1.2rem; flex-wrap: wrap;
        }
        .trust-bar-label {
            font-size: 0.72rem; text-transform: uppercase;
            letter-spacing: 1px; color: rgba(255,255,255,0.45);
            white-space: nowrap;
        }
        .ex-chip {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(255,255,255,0.09);
            border: 1px solid rgba(255,255,255,0.13);
            border-radius: 6px; padding: 5px 13px;
            font-size: 0.78rem; font-weight: 600;
            color: rgba(255,255,255,0.82);
        }

        /* ── Section label pill ── */
        .section-pill {
            display: inline-block;
            border-radius: 50px; padding: 4px 16px;
            font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 1px;
            margin-bottom: 0.9rem;
        }

        /* ── Alternating section bg ── */
        .section-alt { background: rgba(248,249,250,0.6); }
        [data-theme-mode="dark"] .section-alt { background: rgba(0,0,0,0.15); }

        /* ── How It Works steps ── */
        .hiw-step {
            border-radius: 16px; padding: 2rem;
            border: 1px solid rgba(0,0,0,0.08);
            background: var(--custom-white, #fff);
            transition: transform 0.28s ease, box-shadow 0.28s ease;
            height: 100%;
        }
        .hiw-step:hover { transform: translateY(-5px); box-shadow: 0 18px 38px -8px rgba(0,0,0,0.12); }
        .step-num {
            width: 48px; height: 48px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.15rem; font-weight: 800;
            flex-shrink: 0; margin-bottom: 1.1rem;
        }

        /* ── Feature Tabs ── */
        .feature-tab-btn {
            display: flex; align-items: center; gap: 13px;
            padding: 13px 18px;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 12px;
            background: var(--custom-white, #fff);
            cursor: pointer;
            transition: all 0.22s ease;
            text-align: left; width: 100%;
            margin-bottom: 9px;
        }
        .feature-tab-btn:hover { border-color: #6366f1; background: rgba(99,102,241,0.04); }
        .feature-tab-btn.active {
            border-color: #6366f1;
            background: rgba(99,102,241,0.07);
            box-shadow: 0 4px 14px -3px rgba(99,102,241,0.22);
        }
        .tab-icon {
            width: 40px; height: 40px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.15rem; flex-shrink: 0;
        }
        .tab-title  { font-weight: 600; font-size: 0.88rem; line-height: 1.3; }
        .tab-sub    { font-size: 0.76rem; color: #6c757d; margin-top: 2px; }

        .feature-panel { display: none; }
        .feature-panel.active {
            display: block;
            animation: fadeSlideUp 0.32s ease;
        }
        .feature-panel img {
            width: 100%; border-radius: 14px;
            border: 1px solid rgba(0,0,0,0.09);
            box-shadow: 0 22px 48px -10px rgba(0,0,0,0.22);
        }
        .panel-placeholder {
            aspect-ratio: 16/10;
            border-radius: 14px;
            border: 2px dashed rgba(99,102,241,0.3);
            background: rgba(99,102,241,0.04);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            color: #6c757d; text-align: center; padding: 2rem;
        }
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Pricing cards ── */
        .lp-pricing-card {
            border-radius: 16px !important;
            border: 2px solid rgba(0,0,0,0.07) !important;
            transition: transform 0.28s ease, box-shadow 0.28s ease;
        }
        .lp-pricing-card:hover { transform: translateY(-6px); box-shadow: 0 22px 44px -8px rgba(0,0,0,0.13) !important; }
        .lp-pricing-card.lp-popular {
            border-color: #6366f1 !important;
            transform: translateY(-8px);
            box-shadow: 0 18px 40px -8px rgba(99,102,241,0.28) !important;
        }
        .lp-pricing-card.lp-popular:hover { transform: translateY(-13px); }
        .lp-pricing-card.lp-vip  { border-color: #f59e0b !important; }
        .lp-price-big { font-size: 2.8rem; font-weight: 800; line-height: 1; }
        .lp-feat-row {
            display: flex; align-items: flex-start; gap: 9px;
            padding: 7px 0; border-bottom: 1px solid rgba(0,0,0,0.04);
            font-size: 0.88rem;
        }
        .lp-feat-row:last-child { border-bottom: none; }
        .lp-feat-row i { margin-top: 2px; flex-shrink: 0; }

        /* ── CTA pulse ── */
        @@keyframes pulse-cta {
            0%   { box-shadow: 0 0 0 0   rgba(99,102,241,0.5); }
            70%  { box-shadow: 0 0 0 12px rgba(99,102,241,0); }
            100% { box-shadow: 0 0 0 0   rgba(99,102,241,0); }
        }
        .btn-pulse { animation: pulse-cta 2.5s infinite; }

        /* ── Final CTA gradient box ── */
        .final-cta-box {
            border-radius: 22px; padding: 4.5rem 2rem;
            text-align: center; position: relative; overflow: hidden;
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 55%, #1e1b4b 100%);
        }
        .final-cta-box::before, .final-cta-box::after {
            content: ''; position: absolute; border-radius: 50%;
            background: rgba(255,255,255,0.035);
        }
        .final-cta-box::before { width: 320px; height: 320px; top:-90px; right:-70px; }
        .final-cta-box::after  { width: 380px; height: 380px; bottom:-110px; left:-60px; }

        /* ── Sticky CTA bar ── */
        .sticky-cta-bar {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 1050;
            background: rgba(15,15,20,0.96);
            backdrop-filter: blur(14px);
            border-top: 1px solid rgba(255,255,255,0.07);
            padding: 11px 24px;
            display: flex; align-items: center;
            justify-content: center; gap: 1.4rem;
            transform: translateY(100%);
            transition: transform 0.3s ease;
        }
        .sticky-cta-bar.show { transform: translateY(0); }
        .sticky-cta-bar .sticky-text { margin: 0; color: rgba(255,255,255,0.78); font-size: 0.88rem; }
        .sticky-cta-bar .sticky-text strong { color: #fff; }

        /* ── Community cards top accent ── */
        .community-discord { border-top: 3px solid #5865F2 !important; }
        .community-telegram { border-top: 3px solid #229ED9 !important; }
        .community-web      { border-top: 3px solid #6366f1 !important; }

        /* ── Responsive ── */
        @@media (max-width: 767px) {
            .stat-item  { padding: 0.4rem 0.9rem; }
            .stat-number { font-size: 1.5rem; }
            .final-cta-box { padding: 2.8rem 1.4rem; }
            .sticky-cta-bar { gap: 0.7rem; }
            .sticky-text { display: none; }
            .lp-pricing-card.lp-popular { transform: none; }
        }
    </style>
}

<!-- ════════════════════════════════════════════════════
     HERO
     ════════════════════════════════════════════════════ -->
<div class="landing-banner" id="home">
    <section class="section pb-0">
        <div class="container main-banner-container pb-lg-0">
            <div class="row pt-3 align-items-center">

                <!-- Left: copy -->
                <div class="col-xxl-7 col-xl-7 col-lg-7 col-md-8">
                    <div class="pt-lg-5 pb-4">

                        <!-- Live badge -->
                        <div class="hero-live-badge">
                            <span class="pulse-dot"></span>
                            @(ViewBag.ActiveProviderCount) Signal Providers Monitored Live
                        </div>

                        <!-- Headline -->
                        <p class="landing-banner-heading mb-2 text-fixed-white">
                            Stop <span class="fw-semibold text-warning">Trusting</span> Signals.<br>
                            Start <span class="fw-semibold text-warning">Verifying</span> Them.
                        </p>

                        <!-- Typing sub-line -->
