@section scripts {
    <script>
        // ── Typing Effect ──────────────────────────────────────────
        (function () {
            var phrases = [
                'Provider performance \u2014 verified.',
                'Signal accuracy \u2014 verified.',
                'ROI claims \u2014 verified.',
                'Trade timing \u2014 verified.'
            ];
            var pi = 0, ci = 0, deleting = false;
            var el = document.getElementById('typing-text');
            if (!el) return;
            function tick() {
                var phrase = phrases[pi];
                el.textContent = deleting ? phrase.slice(0, ci--) : phrase.slice(0, ci++);
                if (!deleting && ci === phrase.length + 1) {
                    setTimeout(function () { deleting = true; tick(); }, 2000);
                    return;
                }
                if (deleting && ci < 0) {
                    deleting = false;
                    pi = (pi + 1) % phrases.length;
                    ci = 0;
                }
                setTimeout(tick, deleting ? 38 : 78);
            }
            tick();
        }());

        // ── Animated Counters ──────────────────────────────────────
        function animateCounter(el) {
            var target = parseInt(el.getAttribute('data-counter'), 10);
            var suffix = el.getAttribute('data-suffix') || '';
            var duration = 1600;
            var step = target / (duration / 16);
            var cur = 0;
            var t = setInterval(function () {
                cur = Math.min(cur + step, target);
                el.textContent = (cur >= 1000 ? Math.round(cur).toLocaleString() : Math.round(cur)) + suffix;
                if (cur >= target) clearInterval(t);
            }, 16);
        }

        // ── IntersectionObserver: scroll reveal + counters ─────────
        var revealObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
            });
        }, { threshold: 0.12 });

        var counterObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
                if (e.isIntersecting) { animateCounter(e.target); counterObs.unobserve(e.target); }
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.reveal').forEach(function (el) { revealObs.observe(el); });
        document.querySelectorAll('[data-counter]').forEach(function (el) { counterObs.observe(el); });

        // ── Feature Tab Switcher ───────────────────────────────────
        function switchFeatureTab(btn, panelId) {
            document.querySelectorAll('.feature-tab-btn').forEach(function (b) { b.classList.remove('active'); });
            document.querySelectorAll('.feature-panel').forEach(function (p) { p.classList.remove('active'); });
            btn.classList.add('active');
            var panel = document.getElementById(panelId);
            if (panel) panel.classList.add('active');
        }

        // ── Pricing Monthly / Annual Toggle ───────────────────────
        var lpToggle = document.getElementById('lpPricingToggle');
        if (lpToggle) {
            lpToggle.addEventListener('change', function () {
                var annual = lpToggle.checked;
                var proEl = document.getElementById('lp-price-pro');
                var vipEl = document.getElementById('lp-price-vip');
                var proBilled = document.getElementById('lp-price-pro-billed');
                var vipBilled = document.getElementById('lp-price-vip-billed');
                if (annual) {
                    if (proEl) proEl.textContent = proEl.dataset.annual;
                    if (vipEl) vipEl.textContent = vipEl.dataset.annual;
                    if (proBilled) { proBilled.textContent = proBilled.dataset.billed; proBilled.classList.remove('d-none'); }
                    if (vipBilled) { vipBilled.textContent = vipBilled.dataset.billed; vipBilled.classList.remove('d-none'); }
                } else {
                    if (proEl) proEl.textContent = proEl.dataset.monthly;
                    if (vipEl) vipEl.textContent = vipEl.dataset.monthly;
                    if (proBilled) proBilled.classList.add('d-none');
                    if (vipBilled) vipBilled.classList.add('d-none');
                }
            });
        }

        // ── Sticky CTA bar (visible after 500px scroll) ───────────
        var stickyCta = document.getElementById('stickyCta');
        if (stickyCta) {
            window.addEventListener('scroll', function () {
                stickyCta.classList.toggle('show', window.scrollY > 500);
            }, { passive: true });
        }
    </script>
}
