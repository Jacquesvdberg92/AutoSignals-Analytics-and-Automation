                    </button>
                    <button class="feature-tab-btn" onclick="switchFeatureTab(this,'panel-automation')">
                        <span class="tab-icon bg-primary2-transparent text-primary2"><i class="ri-robot-2-line"></i></span>
                        <div>
                            <div class="tab-title">Trade Automation</div>
                            <div class="tab-sub">Paper trade or go live via exchange API</div>
                        </div>
                    </button>
                    <button class="feature-tab-btn" onclick="switchFeatureTab(this,'panel-portfolio')">
                        <span class="tab-icon bg-success-transparent text-success"><i class="ri-pie-chart-line"></i></span>
                        <div>
                            <div class="tab-title">Portfolio Dashboard</div>
                            <div class="tab-sub">Track simulated and live positions</div>
                        </div>
                    </button>
                    <button class="feature-tab-btn" onclick="switchFeatureTab(this,'panel-prices')">
                        <span class="tab-icon bg-warning-transparent text-warning"><i class="ri-currency-line"></i></span>
                        <div>
                            <div class="tab-title">Live Price Comparison</div>
                            <div class="tab-sub">Real-time prices across 4 exchanges</div>
                        </div>
                    </button>
                    <button class="feature-tab-btn" onclick="switchFeatureTab(this,'panel-education')">
                        <span class="tab-icon bg-danger-transparent text-danger"><i class="ri-graduation-cap-line"></i></span>
