                        {
                            <a asp-controller="Portfolio" asp-action="Dashboard" class="m-1 btn btn-lg bg-white-transparent btn-pulse">
                                Go to Dashboard <i class="ri-arrow-right-line ms-2 align-middle"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Register" class="m-1 btn btn-lg bg-white-transparent btn-pulse">
                                Start Free &mdash; 30 Days Pro <i class="ri-rocket-line ms-2 align-middle"></i>
                            </a>
                            <a asp-area="Identity" asp-page="/Account/Login" class="m-1 btn btn-lg btn-outline-light">
                                Sign In <i class="ri-login-box-line ms-2 align-middle"></i>
                            </a>
                        }
                        <a href="#how-it-works" class="m-1 btn btn-lg btn-primary1 btn-wave waves-effect waves-light">
                            See How It Works <i class="ri-arrow-down-line ms-2 align-middle"></i>
                        </a>

                    </div>
                </div>

                <!-- Right: GIF -->
                <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-4 my-auto">
                    <div class="text-end landing-main-image landing-heading-img">
                        <img src="@Url.Content("~/assets/images/media/landing/372102230_BITCOIN_400px.gif")" alt="AutoSignals" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>

        <!-- Stat counters -->
        <div class="container pb-4 mt-1">
            <div class="hero-stats justify-content-center justify-content-lg-start">
                <div class="stat-item">
                    <span class="stat-number" data-counter="5000" data-suffix="+">0</span>
                    <span class="stat-label">Signals Tracked</span>
                </div>
                <div class="stat-divider d-none d-sm-block"></div>
                <div class="stat-item">
                    <span class="stat-number" data-counter="@(ViewBag.ActiveProviderCount)">0</span>
                    <span class="stat-label">Signal Providers</span>
                </div>
                <div class="stat-divider d-none d-sm-block"></div>
                <div class="stat-item">
                    <span class="stat-number" data-counter="4">0</span>
                    <span class="stat-label">Live Exchanges</span>
                </div>
