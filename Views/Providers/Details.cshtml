@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Details - ";
    var user = UserManager.GetUserAsync(User).Result;
    var isVipOrAdmin = user != null &&
                       (UserManager.IsInRoleAsync(user, "VIP").Result ||
                        UserManager.IsInRoleAsync(user, "Admin").Result ||
                        UserManager.IsInRoleAsync(user, "Tester").Result);
}

<!-- Start::page-header -->
<div class="d-flex align-items-center justify-content-between page-header-breadcrumb flex-wrap gap-2 mb-3">
    <div>
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="javascript:void(0);">Providers</a></li>
            <li class="breadcrumb-item active" aria-current="page">@ViewBag.Name</li>
        </ol>
        <h1 class="page-title fw-medium fs-18 mb-0">@ViewBag.Name Details</h1>
    </div>
    <div>
        <span class="badge bg-light text-muted border px-3 py-2">
            <i class="ri-history-line me-1"></i>Data of the past @ViewBag.SignalDaysLabel
        </span>
    </div>
</div>
<!-- End::page-header -->

<!-- Hero Banner -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 overflow-hidden shadow-sm" style="background:linear-gradient(135deg,#0f2027 0%,#203a43 50%,#2c5364 100%);">
            <div class="card-body p-4">
                <div class="d-flex align-items-center flex-wrap gap-4">
                    <div class="flex-shrink-0">
                        @if (ViewBag.Picture != null)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String((byte[])ViewBag.Picture)"
                                 alt="@ViewBag.Name"
                                 class="rounded-circle shadow"
                                 style="width:88px;height:88px;object-fit:cover;border:3px solid rgba(255,255,255,0.45);" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:88px;height:88px;background:rgba(255,255,255,0.1);border:3px solid rgba(255,255,255,0.3);">
                                <i class="ri-user-line" style="font-size:2rem;color:rgba(255,255,255,0.7);"></i>
                            </div>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <h2 class="text-white fw-bold mb-2" style="font-size:1.55rem;">@ViewBag.Name</h2>
                        <div class="d-flex align-items-center gap-3 flex-wrap" style="color:rgba(255,255,255,0.55);font-size:0.83rem;">
                            <span><i class="ri-bar-chart-2-line me-1"></i>@ViewBag.SignalCount signals</span>
                            @if (!string.IsNullOrEmpty(ViewBag.TradeStyle as string))
                            {
                                <span><i class="ri-sword-line me-1"></i>@ViewBag.TradeStyle</span>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.TradeTimeframes as string))
                            {
                                <span><i class="ri-time-line me-1"></i>@ViewBag.TradeTimeframes</span>
                            }
                            @if (!string.IsNullOrEmpty(ViewBag.Telegram as string))
                            {
                                <a href="@ViewBag.Telegram" target="_blank"
                                   style="color:rgba(255,255,255,0.55);text-decoration:none;"
                                   onmouseover="this.style.color='rgba(255,255,255,0.9)'"
                                   onmouseout="this.style.color='rgba(255,255,255,0.55)'">
                                    <i class="ri-telegram-line me-1"></i>Telegram
                                </a>
                            }
                        </div>
                    </div>
                    <div class="d-none d-lg-flex gap-4 align-items-center">
                        <div class="text-center px-4" style="border-left:1px solid rgba(255,255,255,0.18);">
                            <div style="font-size:0.63rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);" class="mb-1">Win Rate</div>
                            <div class="fw-bold text-success" style="font-size:1.9rem;line-height:1.1;">@ViewBag.AverageWinRate<span style="font-size:1rem;color:rgba(255,255,255,0.45);">%</span></div>
                        </div>
                        <div class="text-center px-4" style="border-left:1px solid rgba(255,255,255,0.18);">
                            <div style="font-size:0.63rem;text-transform:uppercase;letter-spacing:1px;color:rgba(255,255,255,0.4);" class="mb-1">RRR</div>
                            <div class="fw-bold text-info" style="font-size:1.9rem;line-height:1.1;">@ViewBag.RRR</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row mb-4 g-3">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card custom-card border-0 text-center p-3 h-100 shadow-sm">
            <div class="mb-2 d-flex justify-content-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:44px;height:44px;background:rgba(40,167,69,0.12);">
                    <i class="ri-arrow-up-circle-line fs-4 text-success"></i>
                </div>
            </div>
            <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Avg Profit</div>
            <div class="fs-18 fw-bold text-success">@ViewBag.AverageProfitPerTrade<span class="text-muted" style="font-size:0.75rem;">%</span></div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card custom-card border-0 text-center p-3 h-100 shadow-sm">
            <div class="mb-2 d-flex justify-content-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:44px;height:44px;background:rgba(220,53,69,0.12);">
                    <i class="ri-arrow-down-circle-line fs-4 text-danger"></i>
                </div>
            </div>
            <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Avg Loss</div>
            <div class="fs-18 fw-bold text-danger">@ViewBag.StoplossPersentage<span class="text-muted" style="font-size:0.75rem;">%</span></div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card custom-card border-0 text-center p-3 h-100 shadow-sm">
            <div class="mb-2 d-flex justify-content-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:44px;height:44px;background:rgba(255,193,7,0.12);">
                    <i class="ri-flashlight-line fs-4 text-warning"></i>
                </div>
            </div>
            <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Avg Leverage</div>
            <div class="fs-18 fw-bold">@ViewBag.AverageLeverage<span class="text-muted" style="font-size:0.75rem;">x</span></div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card custom-card border-0 text-center p-3 h-100 shadow-sm">
            <div class="mb-2 d-flex justify-content-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:44px;height:44px;background:rgba(13,110,253,0.12);">
                    <i class="ri-target-line fs-4 text-primary"></i>
                </div>
            </div>
            <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">TP Targets</div>
            <div class="fs-18 fw-bold">@ViewBag.TakeProfitTargets</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card custom-card border-0 text-center p-3 h-100 shadow-sm">
            <div class="mb-2 d-flex justify-content-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:44px;height:44px;background:rgba(13,202,240,0.12);">
                    <i class="ri-line-chart-line fs-4 text-info"></i>
                </div>
            </div>
            <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Trades / Day</div>
            <div class="fs-18 fw-bold">@ViewBag.TradesPerDay</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card custom-card border-0 text-center p-3 h-100 shadow-sm">
            <div class="mb-2 d-flex justify-content-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:44px;height:44px;background:rgba(108,117,125,0.12);">
                    <i class="ri-close-circle-line fs-4 text-secondary"></i>
                </div>
            </div>
            <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Nullified</div>
            <div class="fs-18 fw-bold text-secondary">@ViewBag.SignalsNullified</div>
        </div>
    </div>
</div>

<!-- Win Rates + Risk Gauge -->
<div class="row mb-4 g-3">
    <div class="col-xl-8 col-lg-7">
        <div class="card custom-card border-0 h-100 shadow-sm">
            <div class="card-header bg-transparent border-bottom-0 px-4 pt-3 pb-0">
                <h6 class="fw-semibold mb-0 fs-14"><i class="ri-donut-chart-line me-2 text-primary"></i>Win Rates</h6>
            </div>
            <div class="card-body d-flex justify-content-around align-items-center flex-wrap p-2">
                <div id="average-winrate-chart"></div>
                <div id="short-winrate-chart"></div>
                <div id="long-winrate-chart"></div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-lg-5">
        <div class="card custom-card border-0 h-100 shadow-sm">
            <div class="card-header bg-transparent border-bottom-0 px-4 pt-3 pb-0">
                <h6 class="fw-semibold mb-0 fs-14"><i class="ri-dashboard-2-line me-2 text-primary"></i>Risk Level</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-2">
                <div id="provider-gauge-chart" style="width:100%;max-width:320px;height:220px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Short/Long Distribution + TP Breakdown -->
<div class="row mb-4 g-3">
    <div class="col-xl-5">
        <div class="card custom-card border-0 h-100 shadow-sm">
            <div class="card-header bg-transparent border-bottom-0 px-4 pt-3 pb-2">
                <h6 class="fw-semibold mb-0 fs-14"><i class="ri-bar-chart-horizontal-line me-2 text-primary"></i>Short / Long Distribution</h6>
            </div>
            <div class="card-body px-4 pt-1 pb-4">
                <div class="d-flex justify-content-between mb-3">
                    <span class="badge px-3 py-1" style="background:rgba(220,53,69,0.1);color:#dc3545;border:1px solid rgba(220,53,69,0.25);">
                        <i class="ri-arrow-down-s-line"></i> Short &nbsp;@ViewBag.ShortCount
                    </span>
                    <span class="badge px-3 py-1" style="background:rgba(40,167,69,0.1);color:#28a745;border:1px solid rgba(40,167,69,0.25);">
                        <i class="ri-arrow-up-s-line"></i> Long &nbsp;@ViewBag.LongCount
                    </span>
                </div>
                <div class="progress rounded-pill mb-4" style="height:22px;">
                    <div class="progress-bar bg-danger" role="progressbar"
                         style="width:@ViewBag.ShortRatio%;"
                         aria-valuenow="@ViewBag.ShortRatio" aria-valuemin="0" aria-valuemax="100">
                        @ViewBag.ShortRatio%
                    </div>
                    <div class="progress-bar bg-success" role="progressbar"
                         style="width:@ViewBag.LongRatio%;"
                         aria-valuenow="@ViewBag.LongRatio" aria-valuemin="0" aria-valuemax="100">
                        @ViewBag.LongRatio%
                    </div>
                </div>
                <div class="row text-center">
                    <div class="col-6 border-end">
                        <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Short Win Rate</div>
                        <div class="fs-18 fw-bold text-danger">@ViewBag.ShortWinRate<span class="text-muted" style="font-size:0.8rem;">%</span></div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted mb-1" style="font-size:0.67rem;text-transform:uppercase;letter-spacing:0.5px;">Long Win Rate</div>
                        <div class="fs-18 fw-bold text-success">@ViewBag.LongWinRate<span class="text-muted" style="font-size:0.8rem;">%</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="card custom-card border-0 h-100 shadow-sm">
            <div class="card-header bg-transparent border-bottom-0 px-4 pt-3 pb-2">
                <h6 class="fw-semibold mb-0 fs-14"><i class="ri-trophy-line me-2 text-primary"></i>Take Profit Breakdown</h6>
            </div>
            <div class="card-body p-3">
                <div id="tp-breakdown-chart"></div>
            </div>
        </div>
    </div>
</div>

<!-- Signals Table -->
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row mb-4">
        <div class="col-xl-12">
            <div class="card custom-card border-0 shadow-sm">
                <div class="card-header bg-transparent px-4 pt-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h6 class="fw-semibold mb-0 fs-14">
                        <i class="ri-signal-tower-line me-2 text-primary"></i>Signals
                        <span class="badge bg-light text-muted border ms-2 fw-normal" style="font-size:0.7rem;">@ViewBag.SignalDaysLabel</span>
                    </h6>
                    @if (ViewBag.IsDelayed == true)
                    {
                        <div class="d-flex align-items-center gap-2 py-1 px-3 rounded-2 small"
                             style="background:rgba(255,193,7,0.1);border:1px solid rgba(255,193,7,0.3);color:#856404;">
                            <i class="ri-time-line"></i>
                            <span>24h delayed — <a asp-controller="Home" asp-action="Pricing" class="fw-semibold" style="color:#856404;">Upgrade</a> for real-time.</span>
                        </div>
                    }
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table id="datatable-basic" class="table table-striped table-hover align-middle" data-order='[[6,"desc"]]'>
                            <thead class="table-light">
                                <tr>
                                    <th>Symbol</th>
                                    <th>Side</th>
                                    <th>Leverage</th>
                                    <th>Entry</th>
                                    <th>Stoploss</th>
                                    <th>Take Profits</th>
                                    <th>Time</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var signal in ViewBag.Signals)
                                {
                                    <tr>
                                        <td class="fw-semibold">@signal.Symbol</td>
                                        <td>
                                            <span class="badge @(signal.Side != null && signal.Side.ToString().ToLower() == "short" ? "bg-danger" : "bg-success") px-2 py-1">
                                                @signal.Side
                                            </span>
                                        </td>
                                        <td>@signal.Leverage<span class="text-muted ms-1" style="font-size:0.75rem;">x</span></td>
                                        <td>@signal.Entry</td>
                                        <td class="text-danger">@signal.Stoploss</td>
                                        <td>@signal.TakeProfits</td>
                                        <td data-order="@signal.Time.Ticks">@signal.Time.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <a asp-controller="Signals" asp-action="Details"
                                               asp-route-id="@signal.Id"
                                               asp-route-providerId="@ViewBag.ProviderId"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="ri-eye-line me-1"></i>View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.3.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- Internal Datatables JS -->
    <script src="@Url.Content("~/assets/js/datatables.js")"></script>

    <!-- Apex Charts JS -->
    <script src="@Url.Content("~/assets/libs/apexcharts/apexcharts.min.js")"></script>

    <!-- ECharts JS -->
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>

    <script>
        $(document).ready(function () {
            var chartAverageWinRate = new ApexCharts(document.querySelector("#average-winrate-chart"), createWinRateChartOptions(@ViewBag.AverageWinRate, 'Average', '#b6b6b6'));
            chartAverageWinRate.render();

            var chartShortWinRate = new ApexCharts(document.querySelector("#short-winrate-chart"), createWinRateChartOptions(@ViewBag.ShortWinRate, 'Short', '#FF4560'));
            chartShortWinRate.render();

            var chartLongWinRate = new ApexCharts(document.querySelector("#long-winrate-chart"), createWinRateChartOptions(@ViewBag.LongWinRate, 'Long', '#00E396'));
            chartLongWinRate.render();

            var gaugeValue = @ViewBag.Risk; // Set your initial value for the provider
            var gaugeChart = initializeGaugeChart('provider-gauge-chart', gaugeValue);

            var seriesData = [];
        @if (ViewBag.TakeProfitDistribution != null)
        {
            for (int i = 0; i < ViewBag.TpCount; i++)
            {
                <text>
                                        seriesData.push({
                                            name: 'Take Profit @(i + 1)',
                                            data: [@ViewBag.TakeProfitDistribution[i]]
                                        });
                </text>
            }
        }
        else
        {
            <text>
                            seriesData.push({
                                name: 'No Data',
                                data: [0]
                            });
            </text>
        }
            initializeStackedBarChart("#tp-breakdown-chart", seriesData);
        });
    </script>
    <script src="@Url.Content("~/assets/dashboards-js/signal-providers-dashboard.js")"></script>
}



