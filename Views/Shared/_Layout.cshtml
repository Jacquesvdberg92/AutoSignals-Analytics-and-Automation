@using AutoSignals.Models
@using AutoSignals.Services
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> LayoutSignInManager
@inject UserManager<IdentityUser> LayoutUserManager
@inject ISubscriptionService LayoutSubscriptionService
@{
    var _pageTitle       = ViewData["Title"]?.ToString();
    var _metaTitle       = string.IsNullOrEmpty(_pageTitle)
                             ? "AutoSignals — Crypto Signal Tracking & Trade Automation"
                             : $"{_pageTitle} | AutoSignals";
    var _metaDescription = ViewData["Description"]?.ToString()
                             ?? "AutoSignals aggregates crypto trading signals from vetted providers, tracks every take-profit and stop-loss in real time, and auto-executes trades on Bitget, Binance, Bybit, OKX and KuCoin. Free to join.";
    var _canonicalUrl    = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var _ogImage         = ViewData["OgImage"]?.ToString()
                             ?? $"{Context.Request.Scheme}://{Context.Request.Host}/assets/images/brand-logos/og-image.png";
}
<!DOCTYPE html>
<html lang="en" dir="ltr" data-nav-layout="vertical" data-theme-mode="dark" data-header-styles="dark" data-menu-styles="dark" data-toggled="close">

<head>

    <!-- META DATA -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="@_metaDescription">
    <meta name="author" content="AutoSignals">
    <meta name="keywords" content="crypto signals, cryptocurrency trading signals, automated crypto trading, signal performance tracking, crypto trade automation, Bitget signals, Binance signals, Bybit signals, OKX signals, KuCoin signals, bitcoin signals, altcoin trading, crypto provider analytics, telegram crypto signals bot, crypto portfolio management">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="@_canonicalUrl">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="AutoSignals">
    <meta property="og:url" content="@_canonicalUrl">
    <meta property="og:title" content="@_metaTitle">
    <meta property="og:description" content="@_metaDescription">
    <meta property="og:image" content="@_ogImage">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="en_US">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@@CL_AutoSignals_Bot">
    <meta name="twitter:title" content="@_metaTitle">
    <meta name="twitter:description" content="@_metaDescription">
    <meta name="twitter:image" content="@_ogImage">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "AutoSignals",
        "alternateName": "AutoSignals.xyz",
        "url": "https://autosignals.xyz",
        "description": "Crypto trading signal aggregation and automation platform. Track signal performance in real time, connect exchange APIs, and automate trades from vetted providers on Bitget, Binance, Bybit, OKX and KuCoin.",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web Browser",
        "featureList": [
            "Real-time crypto signal performance tracking",
            "Multi-exchange trade automation (Bitget, Binance, Bybit, OKX, KuCoin)",
            "Signal provider analytics and win-rate statistics",
            "Take-profit and stop-loss monitoring",
            "Telegram bot signal notifications with chart images",
            "4H candlestick chart generation per signal",
            "Free account registration"
        ],
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "description": "Free to sign up"
        },
        "sameAs": [
            "https://t.me/CL_AutoSignals_Bot",
            "https://autosignals.xyz"
        ]
    }
    </script>

    <!-- TITLE -->
    <title>@_metaTitle</title>

    <!-- FAVICON -->
    <link rel="icon" href="@Url.Content("~/assets/images/brand-logos/favicon.ico")" type="image/x-icon">

    <!-- BOOTSTRAP CSS -->
    <link id="style" href="@Url.Content("~/assets/libs/bootstrap/css/bootstrap.min.css")" rel="stylesheet">

    <!-- STYLES CSS -->
    <link href="@Url.Content("~/assets/css/styles.css")" rel="stylesheet">

    <!-- ICONS CSS -->
    <link href="@Url.Content("~/assets/CSS/icons.css")" rel="stylesheet">

    <partial name="~/Views/Shared/Layouts/_styles.cshtml">

        <!-- MAIN JS -->
        <script src="@Url.Content("~/assets/js/main.js")"></script>

        @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- SWITCHER -->
    <partial name="~/Views/Shared/Layouts/_switcher.cshtml">
        <!-- END SWITCHER -->
        <!-- LOADER -->
        <div id="loader">
            <img src="@Url.Content("~/assets/images/media/loader.svg")" alt="">
        </div>
        <!-- END LOADER -->
        <!-- PAGE -->
        <div class="page">

            <!-- HEADER -->
            <partial name="~/Views/Shared/Layouts/_header.cshtml">

                <!-- END HEADER -->
                <!-- SIDEBAR -->

                <partial name="~/Views/Shared/Layouts/_sidebar.cshtml">

                    <!-- END SIDEBAR -->
                    <!-- MAIN-CONTENT -->

                    <div class="main-content app-content">
                        <div class="container-fluid">
                            @if (LayoutSignInManager.IsSignedIn(User))
                            {
                                var trialUserId = LayoutUserManager.GetUserId(User);
                                if (!string.IsNullOrEmpty(trialUserId))
                                {
                                    var trialData = await LayoutSubscriptionService.GetSubscriptionDataAsync(trialUserId);
                                    if (trialData?.SubscriptionStatus == SubscriptionStatus.Trial && trialData.TrialEndDate.HasValue)
                                    {
                                        var daysLeft = (int)Math.Ceiling((trialData.TrialEndDate.Value - DateTime.UtcNow).TotalDays);
                                        if (daysLeft > 0)
                                        {
                                            <div class="alert alert-primary alert-dismissible fade show d-flex align-items-center gap-3 mb-3" role="alert" style="border-left: 4px solid #6366f1;">
                                                <i class="ti ti-clock fs-5 flex-shrink-0"></i>
                                                <div class="flex-grow-1">
                                                    <span class="fw-semibold">⏱ You have @daysLeft day@(daysLeft == 1 ? "" : "s") left on your Pro trial.</span>
                                                    <span class="ms-2 text-muted">Subscribe now to keep Pro features — from $29/month.</span>
                                                </div>
                                                <div class="d-flex gap-2 flex-shrink-0">
                                                    <a href="/Pricing" class="btn btn-sm btn-primary btn-wave">See Plans</a>
                                                </div>
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                        }
                                    }
                                }
                            }
                            @RenderBody()
                        </div>
                    </div>
                    <!-- END MAIN-CONTENT -->
                    <!-- FOOTER -->
                    <partial name="~/Views/Shared/Layouts/_footer.cshtml">

                        <!-- END FOOTER -->

        </div>
        <!-- END PAGE-->
        <!-- SCRIPTS -->

        <partial name="~/Views/Shared/Layouts/_scripts.cshtml">

            @await RenderSectionAsync("Scripts", required: false)

            <!-- STICKY JS -->
            <script src="@Url.Content("~/assets/js/sticky.js")"></script>

            <!-- CUSTOM JS -->
            <script src="@Url.Content("~/assets/js/custom.js")"></script>

            <!-- CUSTOM-SWITCHER JS -->
            <script src="@Url.Content("~/assets/js/custom-switcher.js")"></script>

            <!-- END SCRIPTS -->

</body>
</html>
